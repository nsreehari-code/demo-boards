{
  "name": "demo-boards",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "node demo-board/test/server-http-test.js && npm run mcp:test",
    "finbook:build": "npm --prefix mcp-server-managed-truthsets/finbook run build",
    "finbook:check": "npm --prefix mcp-server-managed-truthsets/finbook run check",
    "install:foundry": "pip install -r demo-board/server/board-worker/source-def-flows/foundry-handler/requirements.txt",
    "sync:yaml-flow-cli": "node scripts/sync-yaml-flow-cli.cjs",
    "postinstall": "npm run install:foundry && npm run sync:yaml-flow-cli",
    "start": "node scripts/start-server.cjs demo-board --all",
    "frontend": "node ./node_modules/http-server/bin/http-server docs -p 8000 -c-1",
    "mcp:install": "npm --prefix mcp-server install",
    "mcp:test": "npm --prefix mcp-server run test:smoke",
    "mcp:dry-run": "npm --prefix mcp-server run dry-run -- --manifest manifests/demo-boards.workiq.json --manifest manifests/demo-boards.graph.json --manifest ../mcp-server-managed-truthsets/finbook/mcp-executable-manifest.json --transport streamable-http",
    "mcp:start": "npm --prefix mcp-server run start:http",
    "stop": "node -e \"const {execSync}=require('child_process');['7799','7801','8000'].forEach(p=>{try{execSync('npx kill-port '+p,{stdio:'ignore'})}catch{}});console.log('stopped ports 7799, 7801 and 8000')\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "latest",
    "better-sqlite3": "^12.9.0",
    "yaml-flow": "^8.4.13"
  },
  "devDependencies": {
    "http-server": "^14.1.1"
  }
}
