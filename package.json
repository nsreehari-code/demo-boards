{
  "name": "demo-boards",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "install:foundry": "pip install -r demo-board/scripts/foundry/requirements.txt",
    "postinstall": "npm run install:foundry",
    "start": "node scripts/start-server.cjs demo-board --all",
    "backend": "node scripts/start-server.cjs demo-board --backend",
    "frontend": "npx http-server demo-board -p 8000 -c-1",
    "mcp:install": "npm --prefix mcp-server install",
    "mcp:dry-run": "npm --prefix mcp-server run dry-run -- --manifest manifests/demo-boards.workiq.json --manifest manifests/demo-boards.graph.json --manifest ../../fintech/data-repos/finbook-data/managed-truthsets/mcp-executable-manifest.json --transport streamable-http",
    "mcp:start": "npm --prefix mcp-server run start:http",
    "seed-cpm": "node demo-board/scripts/sqlite/seed-cpm.cjs",
    "seed-cpmV2": "node demo-board/scripts/sqlite/seed-cpm.cjs && node demo-board/scripts/sqlite/seed-cpmV2.cjs",
    "seed-optimus": "node demo-board/scripts/sqlite/seed-optimus.cjs",
    "clean": "node -e \"const fs=require('fs'),p=require('path');['live','cpm','cpmV2','optimus'].forEach(sub=>{const d=p.join(__dirname,'demo-board',sub);if(fs.existsSync(d)){for(const e of fs.readdirSync(d,{withFileTypes:true})){if(['cards','gandalf-cards','.gitignore','.retain'].includes(e.name))continue;fs.rmSync(p.join(d,e.name),{recursive:true,force:true});console.log('removed',sub+'/'+e.name)}}});console.log('clean done')\"",
    "stop": "node -e \"const {execSync}=require('child_process');['7799','7801','8000'].forEach(p=>{try{execSync('npx kill-port '+p,{stdio:'ignore'})}catch{}});console.log('stopped ports 7799, 7801 and 8000')\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "latest",
    "better-sqlite3": "^12.9.0",
    "yaml-flow": "^8.2.1"
  },
  "devDependencies": {
    "http-server": "^14.1.1"
  }
}
