{
  "name": "demo-boards",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "index.js",
  "scripts": {
    "check:prereqs": "node scripts/setup-check-copilot-workiq.mjs",
    "test": "node demo-board/test/my-http-test.js && npm run mcp:test",
    "test:firebase": "node demo-board/test/firebase-http-test.js",
    "finbook:build": "npm --prefix mcp-server-managed-truthsets/finbook run build",
    "finbook:check": "npm --prefix mcp-server-managed-truthsets/finbook run check",
    "install:foundry": "pip install -r demo-board/server/board-worker/source-def-flows/foundry-handler/requirements.txt && pip install -r demo-board/server/chat-flow/foundry-chat/requirements.txt",
    "postinstall": "npm run install:foundry && npm run check:prereqs",
    "start": "node scripts/start-server.cjs demo-board --all",
    "ui": "node ./node_modules/http-server/bin/http-server docs -p 8000 -c-1",
    "mcp:install": "npm --prefix mcp-server install",
    "mcp:test": "npm --prefix mcp-server run test:smoke",
    "mcp:dry-run": "npm --prefix mcp-server run dry-run -- --manifest manifests/demo-boards.workiq.json --manifest manifests/demo-boards.graph.json --manifest ../mcp-server-managed-truthsets/finbook/mcp-executable-manifest.json --transport streamable-http",
    "setup:check:copilot-only": "node scripts/setup-check-copilot-workiq.mjs --copilot-only",
    "setup:check:workiq-only": "node scripts/setup-check-copilot-workiq.mjs --workiq-only",
    "setup:check:copilot-workiq": "node scripts/setup-check-copilot-workiq.mjs",
    "mcp:start": "npm --prefix mcp-server run start:http",
    "stop": "node -e \"const {execSync}=require('child_process');['7801','7799','8000'].forEach(p=>{try{execSync('npx kill-port '+p,{stdio:'ignore'})}catch{}});console.log('stopped ports 7801, 7799 and 8000')\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "latest",
    "axios": "^1.16.1",
    "better-sqlite3": "^12.9.0",
    "node-sse": "^0.0.2",
    "yaml-flow": "^8.8.5"
  },
  "devDependencies": {
    "http-server": "^14.1.1"
  }
}
