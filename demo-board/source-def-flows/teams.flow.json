{
  "id": "demo-source-teams",
  "settings": {
    "start_step": "execute",
    "max_total_steps": 8,
    "timeout_ms": 120000
  },
  "steps": {
    "execute": {
      "description": "Execute Teams source def via Zoltbook CLI",
      "handler": {
        "type": "ref",
        "howToRun": "demo-local-module",
        "whatToRun": { "kind": "fs-path", "value": "./source-def-handlers/teams-handler.js" }
      },
      "transitions": {
        "success": "completed",
        "failure": "failed"
      }
    }
  },
  "terminal_states": {
    "completed": {
      "description": "Teams source succeeded",
      "return_intent": "success",
      "return_artifacts": ["resultValue", "wroteOutputDirectly"]
    },
    "failed": {
      "description": "Teams source failed",
      "return_intent": "failure"
    }
  }
}
