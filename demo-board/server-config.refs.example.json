{
  "host": "0.0.0.0",
  "port": 7799,
  "defaultBoard": "live",
  "boards": {
    "live": {
      "label": "Live",
      "subtitle": "Live operational intelligence for agent workflows",
      "chat": { "assistant": "copilot" },
      "setup": {
        "setupRoot": "../workspaces/live/case-workspace",
        "aiWorkspaceRoot": "copilot-workspaces",
        "cardStore": "cards-store",
        "artifactsStore": "cards-files",
        "boardRuntime": "runtime",
        "boardOutputsStore": "board-outputs",
        "chatStore": "cards-chats",
        "scratchStore": "scratch",
        "archivalStore": "runtime-archive"
      },
      "refs": {
        "baseRef": { "kind": "fs-path", "value": "runtime/{{boardId}}" },
        "cardStoreRef": { "kind": "fs-path", "value": "stores/{{boardId}}/cards" },
        "outputsStoreRef": { "kind": "fs-path", "value": "stores/{{boardId}}/outputs" },
        "artifactsStoreRef": { "kind": "fs-path", "value": "stores/{{boardId}}/files" },
        "chatStoreRef": { "kind": "fs-path", "value": "stores/{{boardId}}/chat" },
        "scratchStoreRef": { "kind": "fs-path", "value": "stores/{{boardId}}/scratch" },
        "archiveStoreRef": { "kind": "fs-path", "value": "stores/{{boardId}}/archive" }
      },
      "regular": {
        "seedCardsDir": "./boards/live/cards",
        "taskExecutorPath": "./server/board-worker/task-executor.js",
        "chatHandlerFlowPath": "./server/chat-flow/flow-steps.json"
      }
    }
  }
}