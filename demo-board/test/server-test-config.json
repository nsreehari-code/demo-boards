{
  "port": 7799,
  "chatFlowTimeoutMs": 1800000,
  "chatInvokeRefTimeoutMs": 1800000,
  "chatCopilotTimeoutMs": 1800000,
  "setupRootPerRunBase": "./test/live.test.board-ws-tmp",

  "boards": {
    "live": {
      "label": "Live",
      "setup": {
        "setupRoot": "./test/live.test.board-ws",
        "aiWorkspaceRoot": "copilot-workspaces",
        "cardStore": "cards/store",
        "artifactsStore": "cards/files",
        "boardRuntime": "runtime",
        "boardOutputsStore": "runtime-out",
        "chatStore": "cards/chats",
        "scratchStore": "scratch",
        "archivalStore": "runtime/archive"
      },
      "regular": {
        "seedCardsDir": "./test/live-cards",
        "taskExecutorPath": "./server/board-worker/task-executor.js",
        "chatHandlerFlowPath": "./server/chat-flow/flow-steps.json"
      },
      "copilot-workdirs-setup": [
        {
          "copilot-root": "default",
          "instructionsDirs": ["./server/chat-flow/copilot-chat/instructions", "./boards/live/copilot/default/instructions"],
          "agentsDirs": ["./server/chat-flow/copilot-chat/agents", "./boards/live/copilot/default/agents"],
          "agentsSkills": ["./server/chat-flow/copilot-chat/skills", "./boards/live/copilot/default/skills"],
          "agentsHooks": ["./server/chat-flow/copilot-chat/hooks", "./boards/live/copilot/default/hooks"],
          "copyScripts": ["./scripts/cli"]
        },
        {
          "copilot-root": "gandalf",
          "instructionsDirs": ["./server/chat-flow/copilot-chat/instructions", "./boards/live/copilot/gandalf/instructions"],
          "agentsDirs": ["./server/chat-flow/copilot-chat/agents", "./boards/live/copilot/gandalf/agents"],
          "agentsSkills": ["./server/chat-flow/copilot-chat/skills", "./boards/live/copilot/gandalf/skills"],
          "agentsHooks": ["./server/chat-flow/copilot-chat/hooks", "./boards/live/copilot/gandalf/hooks"],
          "copyScripts": ["./scripts/cli"]
        }
      ]
    }
  }
}
