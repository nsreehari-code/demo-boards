{
  "id": "chat-flow-steps",
  "settings": {
    "start_step": "open_turn",
    "max_total_steps": 10,
    "timeout_ms": 300000
  },
  "steps": {
    "open_turn": {
      "description": "Validate the chat invocation, resolve chat context, and create the processing marker",
      "produces_data": ["boardId", "cardId", "boardSetupRoot", "boardRuntimeDir", "runtimeStatusDir", "cardsDir", "projectRoot", "chatFlowRoot", "userText", "chatsRoot", "cardPrefix", "chatDir", "chatsBlobBasePath", "chatsKeyPrefix", "lastChatFile", "serverUrl", "probe", "chatHandlerMode", "chatCopilotTimeoutMs", "chatTimeMs", "chatProcessingMarkerKey", "processingMarkerPath"],
      "input_validations": [
        "$type(lastChatFile) = \"string\" and $length(lastChatFile) > 0",
        "$type(chatDir) = \"string\" and $length(chatDir) > 0 or ($type(chatsBlobBasePath) = \"string\" and $length(chatsBlobBasePath) > 0 and $type(chatsKeyPrefix) = \"string\" and $length(chatsKeyPrefix) > 0)"
      ],
      "handler": {
        "type": "ref",
        "howToRun": "local-node",
        "whatToRun": {
          "kind": "fs-path",
          "value": "./server/chat-flow/chat-open-turn.js"
        },
        "meta": "chat-handler"
      },
      "transitions": {
        "success": "select_assistant",
        "failure": "cleanup_failure",
        "error": "cleanup_failure"
      }
    },
    "select_assistant": {
      "description": "Choose Copilot by default, or the probe echo assistant when probe mode is enabled",
      "expects_data": ["probe", "chatHandlerMode"],
      "produces_data": ["selectedAssistant"],
      "handler": {
        "type": "compute-jsonata",
        "expr": [
          "data.selectedAssistant = (expects_data.probe = true or expects_data.probe = \"true\" or expects_data.probe = 1 or $lowercase($string(expects_data.chatHandlerMode)) = \"probe\") ? \"probe\" : \"copilot\"",
          "result = data.selectedAssistant"
        ]
      },
      "transitions": {
        "copilot": "copilot_assistant",
        "probe": "probe_assistant",
        "failure": "cleanup_failure",
        "error": "cleanup_failure"
      }
    },
    "copilot_assistant": {
      "description": "Run the Copilot-backed assistant logic to generate the reply",
      "expects_data": ["userText", "boardId", "cardId", "boardSetupRoot", "boardRuntimeDir", "runtimeStatusDir", "cardsDir", "projectRoot", "chatFlowRoot", "chatDir", "chatsBlobBasePath", "lastChatFile", "serverUrl", "chatCopilotTimeoutMs"],
      "produces_data": ["replyText"],
      "input_validations": [
        "$type(userText) = \"string\""
      ],
      "handler": {
        "type": "ref",
        "howToRun": "local-node",
        "whatToRun": {
          "kind": "fs-path",
          "value": "./server/chat-flow/copilot-chat/assistant.js"
        },
        "meta": "chat-handler"
      },
      "transitions": {
        "success": "write_reply",
        "failure": "cleanup_failure",
        "error": "cleanup_failure"
      }
    },
    "probe_assistant": {
      "description": "Run the deterministic echo assistant for probe and test flows",
      "expects_data": ["userText", "chatTimeMs"],
      "produces_data": ["replyText"],
      "input_validations": [
        "$type(userText) = \"string\""
      ],
      "handler": {
        "type": "ref",
        "howToRun": "local-node",
        "whatToRun": {
          "kind": "fs-path",
          "value": "./server/chat-flow/echo-probe/assistant.js"
        },
        "meta": "chat-handler"
      },
      "transitions": {
        "success": "write_reply",
        "failure": "cleanup_failure",
        "error": "cleanup_failure"
      }
    },
    "write_reply": {
      "description": "Append the assistant reply to the chat store",
      "expects_data": ["chatsRoot", "cardPrefix", "replyText"],
      "produces_data": ["replyFile", "replyText"],
      "input_validations": [
        "$type(chatsRoot) = \"string\" and $length(chatsRoot) > 0",
        "$type(cardPrefix) = \"string\" and $length(cardPrefix) > 0",
        "$type(replyText) = \"string\""
      ],
      "handler": {
        "type": "ref",
        "howToRun": "local-node",
        "whatToRun": {
          "kind": "fs-path",
          "value": "./server/chat-flow/chat-write-assistant.js"
        },
        "meta": "chat-handler"
      },
      "transitions": {
        "success": "cleanup_success",
        "failure": "cleanup_failure",
        "error": "cleanup_failure"
      }
    },
    "cleanup_success": {
      "description": "Delete the processing marker after a successful assistant turn",
      "handler": {
        "type": "ref",
        "howToRun": "local-node",
        "whatToRun": {
          "kind": "fs-path",
          "value": "./server/chat-flow/chat-clear-processing.js"
        },
        "meta": "chat-handler"
      },
      "transitions": {
        "success": "completed",
        "failure": "failed",
        "error": "failed"
      }
    },
    "cleanup_failure": {
      "description": "Best-effort processing marker cleanup after a failed assistant turn",
      "handler": {
        "type": "ref",
        "howToRun": "local-node",
        "whatToRun": {
          "kind": "fs-path",
          "value": "./server/chat-flow/chat-clear-processing.js"
        },
        "meta": "chat-handler"
      },
      "transitions": {
        "success": "failed",
        "failure": "failed",
        "error": "failed"
      }
    }
  },
  "terminal_states": {
    "completed": {
      "description": "Chat response written",
      "return_intent": "success",
      "return_artifacts": false
    },
    "failed": {
      "description": "Chat response failed",
      "return_intent": "failure",
      "return_artifacts": false
    }
  }
}
