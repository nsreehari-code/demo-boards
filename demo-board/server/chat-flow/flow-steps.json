{
  "id": "chat-flow-steps",
  "settings": {
    "start_step": "validate_input_data",
    "max_total_steps": 10,
    "timeout_ms": 300000,
    "invoke_timeout_ms": 300000
  },
  "steps": {
    "validate_input_data": {
      "description": "Declare the values entering from input_data and validate the required external flow inputs before internal steps run",
      "expects_data": ["boardId", "cardId", "baseRef", "boardSetupRoot", "cardStoreRef", "chatStoreRef", "artifactsStoreRef", "scratchStoreRef", "chatFlowRoot", "userText", "chatCopilotTimeoutMs"],
      "input_validations": [
        "$type(cardId) = \"string\" and $length(cardId) > 0",
        "$type(boardSetupRoot) = \"string\" and $length(boardSetupRoot) > 0",
        "$type(chatStoreRef) = \"string\" and $length(chatStoreRef) > 0",
        "$type(scratchStoreRef) = \"string\" and $length(scratchStoreRef) > 0",
        "$type(chatFlowRoot) = \"string\" and $length(chatFlowRoot) > 0",
        "$type(userText) = \"string\" and $length($trim(userText)) > 0"
      ],
      "handler": {
        "type": "compute-jsonata",
        "expr": [
          "result = \"success\""
        ]
      },
      "transitions": {
        "success": "select_assistant",
        "failure": "cleanup_failure",
        "error": "cleanup_failure"
      }
    },
    "select_assistant": {
      "description": "Normalize the incoming user text, detect the probe marker, and choose the downstream assistant",
      "expects_data": ["userText", "chatCopilotTimeoutMs"],
      "produces_data": ["chatCopilotTimeoutMs", "selectedAssistant"],
      "input_validations": [
        "$type(userText) = \"string\" and $length($trim(userText)) > 0"
      ],
      "handler": {
        "type": "compute-jsonata",
        "expr": [
          "data._marker = \"__probe__echo__probe__\"",
          "data._markerLen = $length(data._marker)",
          "data._rawMessageText = $trim(expects_data.userText)",
          "data._isEchoProbe = $length(data._rawMessageText) >= (data._markerLen * 2) and $substring(data._rawMessageText, 0, data._markerLen) = data._marker and $substring(data._rawMessageText, $length(data._rawMessageText) - data._markerLen) = data._marker",
          "data.chatCopilotTimeoutMs = ($parsePositiveInt := function($value) { ($type($value) = \"number\" and $value > 0) ? $floor($value) : (($type($value) = \"string\" and $count($match($trim($value), /^[0-9]+$/)) > 0 and $number($trim($value)) > 0) ? $floor($number($trim($value))) : null) }; $fallbackTimeout := $parsePositiveInt(expects_data.chatCopilotTimeoutMs); $fallbackTimeout ? $fallbackTimeout : 300000)",
          "data.selectedAssistant = data._isEchoProbe ? \"probe\" : \"copilot\"",
          "result = data.selectedAssistant"
        ]
      },
      "transitions": {
        "copilot": "copilot_assistant",
        "probe": "probe_assistant",
        "failure": "cleanup_failure",
        "error": "cleanup_failure"
      }
    },
    "copilot_assistant": {
      "description": "Run the Copilot-backed assistant logic, which persists its own assistant reply into chat storage",
      "expects_data": ["boardId", "cardId", "baseRef", "boardSetupRoot", "cardStoreRef", "chatStoreRef", "artifactsStoreRef", "scratchStoreRef", "chatFlowRoot", "chatCopilotTimeoutMs"],
      "produces_data": ["assistantHandled"],
      "input_validations": [
        "$type(boardSetupRoot) = \"string\" and $length(boardSetupRoot) > 0",
        "$type(cardStoreRef) = \"string\" and $length(cardStoreRef) > 0",
        "$type(chatStoreRef) = \"string\" and $length(chatStoreRef) > 0",
        "$type(scratchStoreRef) = \"string\" and $length(scratchStoreRef) > 0",
        "$type(chatFlowRoot) = \"string\" and $length(chatFlowRoot) > 0"
      ],
      "handler": {
        "type": "ref",
        "howToRun": "local-process",
        "whatToRun": {
          "kind": "process-name",
          "value": "node"
        },
        "argsMassaging": {
          "cmdTemplate": ["chatFlowRoot & '/copilot-chat/assistant.js'"],
          "stdinTemplate": "{ 'boardId': boardId, 'cardId': cardId, 'baseRef': baseRef, 'boardSetupRoot': boardSetupRoot, 'cardStoreRef': cardStoreRef, 'chatStoreRef': chatStoreRef, 'artifactsStoreRef': artifactsStoreRef, 'scratchStoreRef': scratchStoreRef, 'chatCopilotTimeoutMs': chatCopilotTimeoutMs }"
        },
        "meta": "chat-handler"
      },
      "transitions": {
        "success": "assistant_clear_processing",
        "failure": "cleanup_failure",
        "error": "cleanup_failure"
      }
    },
    "probe_assistant": {
      "description": "Run the deterministic probe assistant logic, which persists its own assistant reply into chat storage",
      "expects_data": ["chatStoreRef", "cardId", "chatFlowRoot"],
      "produces_data": ["assistantHandled"],
      "input_validations": [
        "$type(chatStoreRef) = \"string\" and $length(chatStoreRef) > 0",
        "$type(cardId) = \"string\" and $length(cardId) > 0",
        "$type(chatFlowRoot) = \"string\" and $length(chatFlowRoot) > 0"
      ],
      "handler": {
        "type": "ref",
        "howToRun": "local-process",
        "whatToRun": {
          "kind": "process-name",
          "value": "node"
        },
        "argsMassaging": {
          "cmdTemplate": ["chatFlowRoot & '/copilot-chat/probe.js'"],
          "stdinTemplate": "{ 'chatStoreRef': chatStoreRef, 'cardId': cardId }"
        },
        "meta": "chat-handler"
      },
      "transitions": {
        "success": "assistant_clear_processing",
        "failure": "cleanup_failure",
        "error": "cleanup_failure"
      }
    },
    "assistant_clear_processing": {
      "description": "Clear processing after the Copilot assistant has already appended the final assistant reply",
      "expects_data": ["chatStoreRef", "cardId"],
      "handler": {
        "type": "ref",
        "howToRun": "local-node",
        "whatToRun": {
          "kind": "yaml-flow-cli",
          "value": "chat-store-cli.js"
        },
        "meta": "chat-handler",
        "argsMassaging": {
          "cmdTemplate": ["'--stdin'"],
          "stdinTemplate": "{ 'storeRef': chatStoreRef, 'cardId': cardId, 'commands': [{ 'command': 'set-processing', 'active': false }] }"
        }
      },
      "transitions": {
        "success": "completed",
        "failure": "cleanup_failure",
        "error": "cleanup_failure"
      }
    },
    "cleanup_failure": {
      "description": "Write a failure system message and clear processing via one chat-store-cli command envelope",
      "expects_data": ["chatStoreRef", "cardId"],
      "handler": {
        "type": "ref",
        "howToRun": "local-node",
        "whatToRun": {
          "kind": "yaml-flow-cli",
          "value": "chat-store-cli.js"
        },
        "meta": "chat-handler",
        "argsMassaging": {
          "cmdTemplate": ["'--stdin'"],
          "stdinTemplate": "{ 'storeRef': chatStoreRef, 'cardId': cardId, 'commands': [{ 'command': 'append', 'role': 'system', 'text': 'AI response failed - the assistant could not generate a reply. Check server configuration and logs.', 'files': [] }, { 'command': 'set-processing', 'active': false }] }"
        }
      },
      "transitions": {
        "success": "failed",
        "failure": "failed",
        "error": "failed"
      }
    }
  },
  "terminal_states": {
    "completed": {
      "description": "Chat response written",
      "return_intent": "success",
      "return_artifacts": false
    },
    "failed": {
      "description": "Chat response failed",
      "return_intent": "failure",
      "return_artifacts": false
    }
  }
}
