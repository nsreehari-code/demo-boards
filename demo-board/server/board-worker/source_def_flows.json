{
  "version": "1.0",
  "description": "Self-contained source-def registry for board-worker runtimes.",
  "executor": "board-worker",
  "subcommands": [
    "run-source-fetch",
    "describe-capabilities",
    "validate-source-def",
    "validate-card-preflight",
    "probe-source-preflight",
    "run-source-preflight"
  ],
  "commonSourceDefFields": {
    "bindTo": {
      "type": "string",
      "required": true,
      "description": "Namespace key — fetched result is written to fetched_sources.<bindTo>."
    },
    "outputFile": {
      "type": "string",
      "required": true,
      "description": "Board-relative output path written by the source executor."
    },
    "projections": {
      "type": "object",
      "required": false,
      "description": "Named projections resolved from card_data/requires before source execution.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "optionalForCompletionGating": {
      "type": "boolean",
      "required": false,
      "description": "When true this source does not block default completion gating."
    },
    "timeout": {
      "type": "integer",
      "required": false,
      "description": "Executor timeout in milliseconds."
    },
    "script": {
      "type": "string",
      "required": false,
      "description": "Legacy direct-run command when no task executor is registered."
    }
  },
  "extraSchema": {
    "description": "Board topology context passed via --extra (base64-encoded JSON, baked at init).",
    "properties": {
      "boardSetupRoot": {
        "type": "string",
        "description": "Absolute path to board root."
      },
      "boardId": {
        "type": "string",
        "description": "Board identifier."
      },
      "boardRuntimeDir": {
        "type": "string",
        "description": "Relative path to runtime dir."
      },
      "runtimeStatusDir": {
        "type": "string",
        "description": "Relative path to runtime-out dir."
      },
      "artifactsStore": {
        "type": "string",
        "description": "Relative path to artifacts store dir."
      },
      "scratchStore": {
        "type": "string",
        "description": "Relative path to scratch workspace dir."
      },
      "serverUrl": {
        "type": "string",
        "description": "Base URL of the hosting server (e.g. http://127.0.0.1:7799). Used by source kinds that call server-side endpoints."
      },
      "boardLiveCardsCliJs": {
        "type": "string",
        "description": "Absolute path to board-live-cards-cli.js when configured by the runtime."
      },
      "stepMachineCliPath": {
        "type": "string",
        "description": "Absolute path to step-machine-cli.js when configured by the runtime."
      }
    }
  },
  "kinds": {
    "urls": {
      "detect": {
        "field": "urls"
      },
      "flow": "./source-def-flows/url.flow.json",
      "supports": {
        "interpolation": true,
        "projections": true,
        "fanOut": true,
        "httpCaching": true,
        "customHeaders": true,
        "customMethod": true
      },
      "validate": [
        {
          "field": "urls",
          "type": "object",
          "message": "urls must be an object."
        },
        {
          "field": "urls.url",
          "type": "string",
          "message": "urls.url is required and must be a string."
        }
      ],
      "probe": {
        "strategy": "http-head",
        "urlFrom": "urls.url"
      },
      "manifest": {
        "description": "URL fetch via interpolation and cache, with optional fan-out over a projected URL list.",
        "inputSchema": {
          "urls": {
            "type": "object",
            "required": true,
            "properties": {
              "url": {
                "type": "string",
                "required": true
              },
              "method": {
                "type": "string",
                "required": false
              },
              "headers": {
                "type": "object",
                "required": false
              },
              "args": {
                "type": "object",
                "required": false
              },
              "cacheTimeout": {
                "type": "number",
                "required": false
              },
              "projectionList": {
                "type": "string",
                "required": false
              }
            }
          },
          "tickersFrom": {
            "type": "string",
            "required": false
          }
        }
      }
    },
    "copilot": {
      "detect": {
        "anyOfFields": [
          "copilot",
          "prompt_template"
        ]
      },
      "flow": "./source-def-flows/copilot.flow.json",
      "supports": {
        "promptTemplates": true,
        "argumentInterpolation": true,
        "structuredResults": true,
        "sandboxedExecution": true
      },
      "validate": [
        {
          "anyOf": [
            {
              "field": "copilot",
              "type": "object"
            },
            {
              "field": "prompt_template",
              "type": "string"
            }
          ],
          "message": "copilot must be an object, or prompt_template must be a top-level string."
        }
      ],
      "probe": {
        "strategy": "command-check",
        "command": "copilot",
        "args": [
          "--version"
        ]
      },
      "manifest": {
        "description": "Invoke Copilot with prompt interpolation.",
        "inputSchema": {
          "copilot": {
            "type": "object",
            "required": false
          },
          "prompt_template": {
            "type": "string",
            "required": false
          }
        }
      }
    },
    "mcp": {
      "detect": {
        "field": "mcp"
      },
      "flow": "./source-def-flows/mcp.flow.json",
      "supports": {
        "namedRegistryServer": true,
        "inlineServerConfig": true,
        "toolArguments": true,
        "hostedIntegrations": true
      },
      "validate": [
        {
          "field": "mcp",
          "type": "object",
          "message": "mcp must be an object."
        },
        {
          "field": "mcp.tool",
          "type": "string",
          "message": "mcp.tool is required and must be a string."
        }
      ],
      "probe": {
        "strategy": "manifest-or-runtime-check",
        "field": "mcp"
      },
      "manifest": {
        "description": "Invoke an MCP tool via a named server registry entry or an inline connection config.",
        "inputSchema": {
          "mcp": {
            "type": "object",
            "required": true,
            "properties": {
              "tool": {
                "type": "string",
                "required": true
              },
              "server": {
                "type": "string|object",
                "required": true,
                "description": "String: logical server name from mcp-server/registry.json. Object: inline connection config (transport, url/command, etc.)."
              },
              "input": {
                "type": "object",
                "required": false
              },
              "args": {
                "type": "object",
                "required": false
              }
            }
          }
        }
      }
    },
    "mock": {
      "detect": {
        "field": "mock"
      },
      "flow": "./source-def-flows/mock.flow.json",
      "supports": {
        "mockLookup": true,
        "offlineTesting": true,
        "projectionAwareProbing": true
      },
      "validate": [
        {
          "field": "mock",
          "type": "string",
          "message": "mock must be a string key."
        }
      ],
      "probe": {
        "strategy": "mock-db-lookup"
      },
      "manifest": {
        "description": "Look up values from demo MOCK_DB map.",
        "inputSchema": {
          "mock": {
            "type": "string",
            "required": true
          }
        }
      }
    },
    "foundry": {
      "detect": {
        "field": "foundry"
      },
      "flow": "./source-def-flows/foundry.flow.json",
      "supports": {
        "promptTemplates": true,
        "managedIdentity": true,
        "structuredResults": true,
        "agentInvocation": true
      },
      "validate": [
        {
          "field": "foundry",
          "type": "object",
          "message": "foundry must be an object."
        },
        {
          "field": "foundry.prompt_template",
          "type": "string",
          "message": "foundry.prompt_template is required and must be a string."
        }
      ],
      "probe": {
        "strategy": "command-check",
        "command": "az",
        "args": ["account", "show"]
      },
      "manifest": {
        "description": "Azure AI Foundry Agent invocation via Managed Identity.",
        "inputSchema": {
          "foundry": {
            "type": "object",
            "required": true,
            "properties": {
              "prompt_template": { "type": "string", "required": true },
              "endpoint": { "type": "string", "required": false },
              "agent_id": { "type": "string", "required": false },
              "args": { "type": "object", "required": false },
              "result_shape": { "type": "object", "required": false }
            }
          }
        }
      }
    },
    "sqlite": {
      "detect": {
        "field": "sqlite"
      },
      "flow": "./source-def-flows/sqlite.flow.json",
      "supports": {
        "parameterizedQueries": true,
        "readQueries": true,
        "execMode": true,
        "localDatabaseAccess": true
      },
      "validate": [
        {
          "field": "sqlite",
          "type": "object",
          "message": "sqlite must be an object."
        },
        {
          "field": "sqlite.db",
          "type": "string",
          "message": "sqlite.db is required and must be a string."
        },
        {
          "field": "sqlite.query",
          "type": "string",
          "message": "sqlite.query is required and must be a string."
        }
      ],
      "probe": {
        "strategy": "mock-db-lookup"
      },
      "manifest": {
        "description": "Query a SQLite database via the sqlite handler's local query runner.",
        "inputSchema": {
          "sqlite": {
            "type": "object",
            "required": true,
            "properties": {
              "db": { "type": "string", "required": true },
              "query": { "type": "string", "required": true },
              "params": { "type": "array", "required": false },
              "mode": { "type": "string", "required": false }
            }
          }
        }
      }
    }
  },
  "resolveOrder": [
    "urls",
    "copilot",
    "mcp",
    "foundry",
    "sqlite",
    "mock"
  ]
}
