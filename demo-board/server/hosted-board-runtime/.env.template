# ---------------------------------------------------------------------------
# hosted-board-runtime environment template
# ---------------------------------------------------------------------------
# Copy this file to `.env` (same folder) and fill in real values.
#   cp .env.template .env
# `.env` is gitignored and loaded automatically by the controlface and
# queue-runner processes at startup. All variables are OPTIONAL and override
# the matching fields in hosted-board-runtime.localfs.config.json when set.
# ---------------------------------------------------------------------------

# --- Azure AI Foundry (only needed when a board/card uses the foundry AI) ----
# Overrides the foundryAgents block in the hosted config.
#FOUNDRY_ENDPOINT=https://YOUR-FOUNDRY.services.ai.azure.com/api/projects/YOUR-PROJECT
#FOUNDRY_CHAT_AGENT_ID=asst_xxxxxxxxxxxxxxxxxxxxxxxx
#FOUNDRY_TASK_EXECUTOR_AGENT_ID=asst_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Firebase (only needed when running with storageAdapter: firebase) -------
# Overrides firebase.firebaseConfig in the hosted config (per field).
#FIREBASE_API_KEY=
#FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
#FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
#FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
#FIREBASE_MESSAGING_SENDER_ID=
#FIREBASE_APP_ID=

# --- MCP server URL override ------------------------------------------------
# Also honored by the hosted config loader (defaults to the config value).
#DEMO_BOARDS_MCP_SERVER_URL=http://127.0.0.1:7801/mcp
