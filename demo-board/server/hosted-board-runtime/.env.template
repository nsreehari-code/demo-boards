# ---------------------------------------------------------------------------
# hosted-board-runtime environment template
# ---------------------------------------------------------------------------
# Copy this file to `.env` (same folder) and fill in real values.
#   cp .env.template .env
# `.env` is gitignored and loaded automatically by the controlface and
# queue-runner processes at startup. All variables are OPTIONAL and override
# the matching fields in hosted-board-runtime.localfs.config.json when set.
# ---------------------------------------------------------------------------

# --- Azure AI Foundry (only needed when a board/card uses the foundry AI) ----
# Overrides the foundryAgents block in the hosted config.
#FOUNDRY_ENDPOINT=https://YOUR-FOUNDRY.services.ai.azure.com/api/projects/YOUR-PROJECT
#FOUNDRY_CHAT_AGENT_ID=asst_xxxxxxxxxxxxxxxxxxxxxxxx
#FOUNDRY_TASK_EXECUTOR_AGENT_ID=asst_xxxxxxxxxxxxxxxxxxxxxxxx

# --- MCP server URL override ------------------------------------------------
# Also honored by the hosted config loader (defaults to the config value).
#DEMO_BOARDS_MCP_SERVER_URL=http://127.0.0.1:7801/mcp

# --- Queue-runner lane tuning -----------------------------------------------
# All of these are OPTIONAL and override the matching hosted-config fields
# (queueConcurrency, queueFallbackPollMs, queueBoardRefreshMs,
# chatAgentVisibilityMs, taskExecutorVisibilityMs, processAccumulatedVisibilityMs).
# When a lane's visibility is left unset it defaults to the assistant timeout
# (max of chatCopilotTimeoutMs / chatFlowTimeoutMs / chatInvokeRefTimeoutMs,
# default 2100000) plus 60000ms, so a long-running AI task never has its lease
# reclaimed and re-executed mid-run.
#DEMO_BOARDS_QUEUE_CONCURRENCY=1
#DEMO_BOARDS_QUEUE_FALLBACK_POLL_MS=3000
#DEMO_BOARDS_QUEUE_BOARD_REFRESH_MS=5000
#DEMO_BOARDS_CHAT_AGENT_VISIBILITY_MS=2160000
#DEMO_BOARDS_TASK_EXECUTOR_VISIBILITY_MS=2160000
#DEMO_BOARDS_PROCESS_ACCUMULATED_VISIBILITY_MS=2160000
