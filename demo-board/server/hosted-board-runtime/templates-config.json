{
  "refsTemplates": {
    "localfs-default": {
      "baseRef": {
        "kind": "fs-path",
        "value": "{{BOARD_ROOT}}/workspaces/{{boardId}}"
      },
      "boardRuntimeStoreRef": {
        "kind": "fs-path",
        "value": "{{BOARD_ROOT}}/workspaces/{{boardId}}/runtime-board"
      },
      "cardStoreRef": {
        "kind": "fs-path",
        "value": "{{BOARD_ROOT}}/workspaces/{{boardId}}/cards-store"
      },
      "outputsStoreRef": {
        "kind": "fs-path",
        "value": "{{BOARD_ROOT}}/workspaces/{{boardId}}/runtime-outputs"
      },
      "queueStoreRef": {
        "kind": "fs-path",
        "value": "{{BOARD_ROOT}}/workspaces/{{boardId}}/queue-store"
      },
      "scratchStoreRef": {
        "kind": "fs-path",
        "value": "{{BOARD_ROOT}}/workspaces/{{boardId}}/scratch"
      },
      "archiveStoreRef": {
        "kind": "fs-path",
        "value": "{{BOARD_ROOT}}/workspaces/{{boardId}}/archive"
      },
      "chatStoreRef": {
        "kind": "fs-path",
        "value": "{{BOARD_ROOT}}/workspaces/{{boardId}}/cards-chat"
      },
      "artifactsStoreRef": {
        "kind": "fs-path",
        "value": "{{BOARD_ROOT}}/workspaces/{{boardId}}/cards-files"
      },
      "fetchedSourcesStoreRef": {
        "kind": "fs-path",
        "value": "{{BOARD_ROOT}}/workspaces/{{boardId}}/fetched-sources"
      }
    }
  },
  "aiWorkspaceTemplates": {
    "default": {
      "paths": {
        "aiWorkspaceRoot": "{{BOARD_ROOT}}/workspaces/{{boardId}}/chat-workspaces",
        "scratchStore": "{{BOARD_ROOT}}/workspaces/{{boardId}}/tmp"
      },
      "ai-workdirs-setup": [
        {
          "copilot-root": "default",
          "instructionsDirs": ["{{BOARD_ROOT}}/server/chat-flow/instructions", "{{BOARD_ROOT}}/boards/{{boardId}}/copilot/default/instructions"],
          "agentsDirs": ["{{BOARD_ROOT}}/server/chat-flow/copilot-chat/agents", "{{BOARD_ROOT}}/boards/{{boardId}}/copilot/default/agents"],
          "agentsSkills": ["{{BOARD_ROOT}}/server/chat-flow/skills", "{{BOARD_ROOT}}/boards/{{boardId}}/copilot/default/skills"],
          "agentsHooks": ["{{BOARD_ROOT}}/server/chat-flow/copilot-chat/hooks", "{{BOARD_ROOT}}/boards/{{boardId}}/copilot/default/hooks"],
          "copyScripts": []
        },
        {
          "copilot-root": "worker-default",
          "instructionsDirs": ["{{BOARD_ROOT}}/server/chat-flow/instructions", "{{BOARD_ROOT}}/boards/{{boardId}}/copilot/worker-default/instructions"],
          "agentsDirs": ["{{BOARD_ROOT}}/server/chat-flow/copilot-chat/agents", "{{BOARD_ROOT}}/boards/{{boardId}}/copilot/worker-default/agents"],
          "agentsSkills": ["{{BOARD_ROOT}}/server/chat-flow/skills", "{{BOARD_ROOT}}/boards/{{boardId}}/copilot/worker-default/skills"],
          "agentsHooks": ["{{BOARD_ROOT}}/server/chat-flow/copilot-chat/hooks", "{{BOARD_ROOT}}/boards/{{boardId}}/copilot/worker-default/hooks"],
          "copyScripts": []
        },
        {
          "copilot-root": "gandalf",
          "instructionsDirs": ["{{BOARD_ROOT}}/server/chat-flow/instructions", "{{BOARD_ROOT}}/boards/{{boardId}}/copilot/gandalf/instructions"],
          "agentsDirs": ["{{BOARD_ROOT}}/server/chat-flow/copilot-chat/agents", "{{BOARD_ROOT}}/boards/{{boardId}}/copilot/gandalf/agents"],
          "agentsSkills": ["{{BOARD_ROOT}}/server/chat-flow/skills", "{{BOARD_ROOT}}/boards/{{boardId}}/copilot/gandalf/skills"],
          "agentsHooks": ["{{BOARD_ROOT}}/server/chat-flow/copilot-chat/hooks", "{{BOARD_ROOT}}/boards/{{boardId}}/copilot/gandalf/hooks"],
          "copyScripts": []
        },
        {
          "copilot-root": "strategist",
          "instructionsDirs": ["{{BOARD_ROOT}}/server/chat-flow/instructions", "{{BOARD_ROOT}}/server/chat-flow/instructions-strategist", "{{BOARD_ROOT}}/boards/{{boardId}}/copilot/strategist/instructions"],
          "agentsDirs": ["{{BOARD_ROOT}}/server/chat-flow/copilot-chat/agents", "{{BOARD_ROOT}}/boards/{{boardId}}/copilot/strategist/agents"],
          "agentsSkills": ["{{BOARD_ROOT}}/server/chat-flow/skills", "{{BOARD_ROOT}}/boards/{{boardId}}/copilot/strategist/skills"],
          "agentsHooks": ["{{BOARD_ROOT}}/server/chat-flow/copilot-chat/hooks", "{{BOARD_ROOT}}/server/chat-flow/hooks-strategist", "{{BOARD_ROOT}}/boards/{{boardId}}/copilot/strategist/hooks"],
          "copyScripts": []
        }
      ],
      "copilotSetupScripts": [
        {
          "script": "{{BOARD_ROOT}}/server/sync-copilot-mcp-config.js",
          "args": ["--refresh", "--agentface-url", "{{AGENT_FACE_MCP_URL}}"]
        }
      ]
    }
  },
  "runtimeBoardsRegistry": {
    "localfs": {
      "boards-index": {
        "kind": "fs-path",
        "value": "{{BOARD_ROOT}}/workspaces/_boards-index"
      },
      "boards-layout": {
        "kind": "fs-path",
        "value": "{{BOARD_ROOT}}/workspaces/_boards-layout"
      },
      "deprecatedContainer": {
        "kind": "fs-path",
        "value": "{{BOARD_ROOT}}/workspaces/_deprecated"
      }
    }
  },
  "sampleTemplateCatalog": {
    "dir": "{{BOARD_ROOT}}/server/hosted-board-runtime/sample-card-templates",
    "indexFile": "{{BOARD_ROOT}}/server/hosted-board-runtime/sample-card-templates/_index.json"
  },
  "uiTemplates": {
    "default": {
      "paneRules": [
        {
          "pane": "gandalf",
          "when": "meta.gandalf = true"
        },
        {
          "pane": "truthset",
          "when": "meta.truthset = true"
        }
      ],
      "cardRendererRules": [
        {
          "renderer": "strategist",
          "when": "meta.card_renderer = 'strategist'"
        },
        {
          "renderer": "ingest",
          "when": "meta.card_renderer = 'ingest'"
        },
        {
          "renderer": "postbox",
          "when": "meta.card_renderer = 'postbox'"
        }
      ],
      "admin-cards": [
        {
          "id": "gandalf-intake",
          "meta": {
            "title": "Board Instructions and Intake",
            "gandalf": true,
            "card_renderer": "ingest",
            "desc": "Board intake card for reviewing and managing incoming evidence."
          },
          "__private": {
            "chat": {"copilot": {"ws": "gandalf"} }
          },
          "view": {
            "elements": [
              {
                "kind": "markdown",
                "data": {
                  "value": "Review and manage incoming evidence for this board."
                }
              }
            ]
          },
          "card_data": {}
        },
                {
          "id": "gandalf-postbox",
          "meta": {
            "title": "Postbox",
            "desc": "Postbox card for ingesting documents into the board via Gandalf. Visible only in Control Plane.",
            "card_renderer": "postbox",
            "gandalf": true
          },
          "view": {
            "elements": [
                            {
                "kind": "markdown",
                "data": {
                  "value": "Review and manage incoming evidence for this board."
                }
              }
            ]
          },
          "card_data": {},
          "__private": {
            "visible_controlplane_only": true
          }
        }
      ]
    },
    "journeys": {
      "paneRules": [
        {
          "pane": "gandalf",
          "when": "meta.gandalf = true"
        },
        {
          "pane": "truthset",
          "when": "meta.truthset = true"
        }
      ],
      "cardRendererRules": [
        {
          "renderer": "strategist",
          "when": "meta.card_renderer = 'strategist'"
        },
        {
          "renderer": "ingest",
          "when": "meta.card_renderer = 'ingest'"
        },
        {
          "renderer": "postbox",
          "when": "meta.card_renderer = 'postbox'"
        }
      ],
      "admin-cards": [
        {
          "id": "gandalf-intake",
          "meta": {
            "title": "Board Instructions and Intake",
            "gandalf": true,
            "card_renderer": "ingest"
          },
          "__private": {
            "chat": {"copilot": {"ws": "gandalf"}, "visible_controlplane_only": true }
          },
          "view": {
            "elements": [
              {
                "kind": "markdown",
                "data": {
                  "value": "Review and manage incoming evidence for this board."
                }
              }
            ]
          },
          "card_data": {}
        },

        {
          "id": "journey-strategist",
          "meta": {
            "title": "Journey Strategist",
            "gandalf": true,
            "card_renderer": "strategist",
            "tags": ["strategist", "journey", "exploration"],
            "desc": "Board-level journey strategist. Wakes on compact observatory updates, reads the current journey via board-inspection tools, and authors the next move — new or updated cards — to keep the journey advancing toward its objective.",
            "presentation": {
              "footprint": "wide"
            }
          },
          "__private": {
            "chat": {"copilot": {"ws": "gandalf"}, "visible_controlplane_only": true }
          },
          "requires": [
            "journey_observables",
            "board_observables"
          ],
          "source_defs": [
            {
              "bindTo": "journey_move",
              "outputFile": "journey-strategist-move.json",
              "projections": {
                "steering": "card_data.steering",
                "scope": "card_data.scope",
                "interaction_policy": "card_data.interaction_policy",
                "journey_observables": "requires.journey_observables",
                "board_observables": "requires.board_observables",
                "journey_card_count": "requires.journey_observables.signals.card_count",
                "journey_completed_count": "requires.journey_observables.signals.completed_count",
                "journey_in_progress_count": "requires.journey_observables.signals.in_progress_count",
                "journey_blocked_count": "requires.journey_observables.signals.blocked_count",
                "journey_failed_count": "requires.journey_observables.signals.failed_count",
                "journey_cards_fully_satisfied": "requires.journey_observables.signals.cards_fully_satisfied",
                "journey_settled": "requires.journey_observables.signals.settled",
                "journey_value": "requires.journey_observables.gauge.journey_value",
                "journey_value_band": "requires.journey_observables.gauge.journey_value_band",
                "max_new_cards_per_cycle": "card_data.max_new_cards_per_cycle",
                "max_depth": "card_data.max_depth",
                "max_breadth": "card_data.max_breadth"
              },
              "copilot": {
                "ws": "strategist",
                "session_mode": "continue",
                "result_shape": {
                  "status": null,
                  "move": null,
                  "rationale": null,
                  "created_cards": null,
                  "updated_cards": null,
                  "next_candidates": null
                },
                "prompt_template": "You are the Journey Strategist on the \"{{boardId}}\" journey board. Your workspace instructions (copilot-instructions.md) and skills define the board substrate, the card-authoring contract, the Journey Strategist engine, and this board's journey domain — follow them. This is only your task brief for this cycle.\n\nRUNTIME HANDLES (use exactly): board_id is \"{{boardId}}\". On every liveboards.* tool call that takes a board_id (or board) argument, pass this exact board_id, and pass the provided log_id unchanged.\n\nSTEERING (optional analyst guardrails or priorities; may be empty):\n{{steering}}\n\nSCOPE (optional in-scope data domains, time window, sensitivity; may be empty):\n{{scope}}\n\nINTERACTION POLICY (how autonomous to be; when to surface a decision):\n{{interaction_policy}}\n\nYou were woken because the board changed.\n\nOBSERVATORY SIGNALS (deterministic evidence about the current work graph — facts, not judgments):\n- journey cards: {{journey_card_count}} (completed {{journey_completed_count}}, in progress {{journey_in_progress_count}})\n- blocked: {{journey_blocked_count}}, failed: {{journey_failed_count}}\n- cards fully satisfied: {{journey_cards_fully_satisfied}}; settled: {{journey_settled}}\n\nOBSERVATORY GAUGE (a cheap heuristic the observatory computes for the UI dashboard — a hint, NOT a verdict): value {{journey_value}}, band {{journey_value_band}}.\n\nYou are the semantic judge of journey health, not the gauge. Read the signals above and sense the board yourself with liveboards.* tools, then form your own assessment of coverage and alignment against the intent. Do not treat the gauge as ground truth — it is a coarse arithmetic proxy that cannot understand the intent the way you can.\n\nThis cycle: sense the board first, then make the single move that most advances the journey and its alignment — deepen, broaden, clarify, offer a decision, reconcile, or hold steady, per your Journey Strategist engine doctrine. Pace: about {{max_new_cards_per_cycle}} authoring move(s), within ~{{max_depth}} steps deep and ~{{max_breadth}} parallel threads. Build on existing tokens; never re-query what a token already holds.\n\nRespond with a single JSON object and nothing else, beginning with { and ending with }:\n\n{\n  \"status\": \"advancing | waiting | aligned\",\n  \"move\": \"deepen | broaden | clarify | decide | reconcile | hold\",\n  \"rationale\": \"<a sentence or two grounded in what you actually read, including whether the observatory signal says value is rising, stalled, or impaired>\",\n  \"created_cards\": [ { \"card_id\": \"<id>\", \"purpose\": \"<short>\", \"parent\": \"<parent card id or null>\", \"shape\": \"kusto | copilot | interactive | compute\" } ],\n  \"updated_cards\": [ { \"card_id\": \"<id>\", \"change\": \"<short, e.g. path_state=dead_ended>\" } ],\n  \"next_candidates\": [ \"<a branch you noticed but chose to defer>\" ]\n}"
              }
            }
          ],
          "compute": [
            {
              "bindTo": "status_value",
              "expr": "fetched_sources.journey_move.status ? fetched_sources.journey_move.status : 'idle'"
            },
            {
              "bindTo": "cards_created_count",
              "expr": "fetched_sources.journey_move.created_cards ? $count(fetched_sources.journey_move.created_cards) : 0"
            },
            {
              "bindTo": "journey_size",
              "expr": "requires.journey_observables.signals.card_count ? requires.journey_observables.signals.card_count : 0"
            },
            {
              "bindTo": "rationale",
              "expr": "fetched_sources.journey_move.rationale"
            },
            {
              "bindTo": "created_table",
              "expr": "fetched_sources.journey_move.created_cards"
            },
            {
              "bindTo": "next_candidates_list",
              "expr": "fetched_sources.journey_move.next_candidates"
            },
            {
              "bindTo": "move",
              "expr": "fetched_sources.journey_move"
            }
          ],
          "provides": [
            {
              "bindTo": "journey_move",
              "ref": "computed_values.move"
            }
          ],
          "view": {
            "elements": [
              {
                "kind": "notes",
                "label": "Steering / Guardrails (optional)",
                "data": {
                  "bind": "card_data.steering",
                  "writeTo": "card_data.steering"
                }
              },
              {
                "kind": "notes",
                "label": "Scope — data domains, time window (optional)",
                "data": {
                  "bind": "card_data.scope",
                  "writeTo": "card_data.scope"
                }
              },
              {
                "kind": "badge",
                "label": "Strategist Status",
                "data": {
                  "bind": "computed_values.status_value",
                  "colorMap": {
                    "advancing": "success",
                    "waiting": "warning",
                    "aligned": "blue",
                    "idle": "secondary"
                  }
                }
              },
              {
                "kind": "metric",
                "label": "Cards Added This Cycle",
                "data": {
                  "bind": "computed_values.cards_created_count"
                }
              },
              {
                "kind": "metric",
                "label": "Journey Size (cards)",
                "data": {
                  "bind": "computed_values.journey_size"
                }
              },
              {
                "kind": "markdown",
                "label": "Rationale",
                "data": {
                  "bind": "computed_values.rationale"
                }
              },
              {
                "kind": "table",
                "label": "Cards Created This Cycle",
                "data": {
                  "bind": "computed_values.created_table",
                  "columns": [
                    "card_id",
                    "purpose",
                    "parent"
                  ],
                  "maxRows": 12
                }
              },
              {
                "kind": "list",
                "label": "Deferred Branches",
                "data": {
                  "bind": "computed_values.next_candidates_list",
                  "placeholder": "No deferred branches"
                }
              }
            ]
          },
          "card_data": {
            "steering": "",
            "scope": "",
            "interaction_policy": "Follow this board's journey domain for how autonomous to be. Where the domain says the brief is sufficient and to proceed, proceed and keep the journey advancing; surface a decision or clarification card only when the domain calls for the user's judgement or for an input it cannot supply itself.",
            "max_new_cards_per_cycle": 2,
            "max_depth": 6,
            "max_breadth": 4
          }
        },
        {
          "id": "card-journey-observatory",
          "meta": {
            "title": "Journey Observatory",
            "tags": ["observatory", "journey", "observables"],
            "desc": "Reads the board's own runtime status whenever the journey graph changes and publishes a compact observatory object plus UI metrics for the strategist. Deterministic observation only — it never authors cards.",
            "presentation": {
              "footprint": "wide"
            }
          },
          "__private": {
            "visible_controlplane_only": true
          },
          "requires": [
            "sys_keys_board_state"
          ],
          "source_defs": [
            {
              "bindTo": "observations",
              "outputFile": "journey-observatory-observations.json",
              "observables": {
                "scope": "board-runtime",
                "excludeCardIds": ["journey-strategist", "card-journey-observatory"]
              }
            }
          ],
          "compute": [
            { "bindTo": "obs_card_count", "expr": "fetched_sources.observations.card_count ? fetched_sources.observations.card_count : 0" },
            { "bindTo": "obs_completed_count", "expr": "fetched_sources.observations.completed_count ? fetched_sources.observations.completed_count : 0" },
            { "bindTo": "obs_failed_count", "expr": "fetched_sources.observations.failed_count ? fetched_sources.observations.failed_count : 0" },
            { "bindTo": "obs_blocked_count", "expr": "fetched_sources.observations.blocked_count ? fetched_sources.observations.blocked_count : 0" },
            { "bindTo": "obs_in_progress_count", "expr": "fetched_sources.observations.in_progress_count ? fetched_sources.observations.in_progress_count : 0" },
            { "bindTo": "obs_settled", "expr": "fetched_sources.observations.settled = true" },
            { "bindTo": "obs_satisfied_ratio", "expr": "fetched_sources.observations.card_count > 0 ? (fetched_sources.observations.cards_fully_satisfied / fetched_sources.observations.card_count) : 0" },
            { "bindTo": "obs_progress_ratio", "expr": "$min([1, (fetched_sources.observations.completed_count / 5)])" },
            {
              "bindTo": "journey_value",
              "expr": "fetched_sources.observations.card_count > 0 ? $round($max([0, $min([100, computed_values.obs_progress_ratio * (70 + computed_values.obs_satisfied_ratio * 20 + (computed_values.obs_settled ? 10 : 0)) - fetched_sources.observations.failed_count * 25 - fetched_sources.observations.blocked_count * 15])])) : 0"
            },
            {
              "bindTo": "journey_value_band",
              "expr": "fetched_sources.observations.card_count = 0 ? 'empty' : (computed_values.journey_value >= 85 ? 'healthy' : (computed_values.journey_value >= 55 ? 'building' : 'low'))"
            },
            {
              "bindTo": "journey_observables",
              "expr": "{'signals': {'card_count': computed_values.obs_card_count, 'completed_count': computed_values.obs_completed_count, 'in_progress_count': computed_values.obs_in_progress_count, 'blocked_count': computed_values.obs_blocked_count, 'failed_count': computed_values.obs_failed_count, 'blocked_card_ids': fetched_sources.observations.blocked_card_ids, 'failed_card_ids': fetched_sources.observations.failed_card_ids, 'in_progress_card_ids': fetched_sources.observations.in_progress_card_ids, 'cards_fully_satisfied': fetched_sources.observations.cards_fully_satisfied, 'cards_with_missing_requires': fetched_sources.observations.cards_with_missing_requires, 'settled': computed_values.obs_settled}, 'gauge': {'journey_value': computed_values.journey_value, 'journey_value_band': computed_values.journey_value_band}}"
            },
            {
              "bindTo": "board_observables",
              "expr": "requires.sys_keys_board_state"
            }
          ],
          "provides": [
            { "bindTo": "journey_observables", "ref": "computed_values.journey_observables" },
            { "bindTo": "board_observables", "ref": "computed_values.board_observables" }
          ],
          "view": {
            "elements": [
              {
                "kind": "metric",
                "label": "Journey Value",
                "data": { "bind": "computed_values.journey_value" }
              },
              {
                "kind": "badge",
                "label": "Value Band",
                "data": {
                  "bind": "computed_values.journey_value_band",
                  "colorMap": {
                    "healthy": "success",
                    "building": "warning",
                    "low": "secondary",
                    "empty": "secondary"
                  }
                }
              },
              {
                "kind": "metric",
                "label": "Cards (work graph)",
                "data": { "bind": "computed_values.obs_card_count" }
              },
              {
                "kind": "metric",
                "label": "Completed",
                "data": { "bind": "computed_values.obs_completed_count" }
              },
              {
                "kind": "metric",
                "label": "Blocked",
                "data": { "bind": "computed_values.obs_blocked_count" }
              },
              {
                "kind": "metric",
                "label": "Failed",
                "data": { "bind": "computed_values.obs_failed_count" }
              }
            ]
          },
          "card_data": {}
        }
      ]
    }
  }
}