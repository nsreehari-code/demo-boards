  "aiWorkspaceTemplates": {
    "default": {
      "paths": {
        "aiWorkspaceRoot": "{{BOARD_ROOT}}/workspaces/{{boardId}}/chat-workspaces",
        "scratchStore": "{{BOARD_ROOT}}/workspaces/{{boardId}}/tmp"
      },
      "ai-workdirs-setup": [
        {
          "copilot-root": "default",
          "instructionsDirs": ["{{BOARD_ROOT}}/server/chat-flow/instructions", "{{BOARD_ROOT}}/boards/{{boardId}}/copilot/default/instructions"],
          "agentsDirs": ["{{BOARD_ROOT}}/server/chat-flow/copilot-chat/agents", "{{BOARD_ROOT}}/boards/{{boardId}}/copilot/default/agents"],
          "agentsSkills": ["{{BOARD_ROOT}}/server/chat-flow/skills", "{{BOARD_ROOT}}/boards/{{boardId}}/copilot/default/skills"],
          "agentsHooks": ["{{BOARD_ROOT}}/server/chat-flow/copilot-chat/hooks", "{{BOARD_ROOT}}/boards/{{boardId}}/copilot/default/hooks"],
          "copyScripts": []
        },
        {
          "copilot-root": "worker-default",
          "instructionsDirs": ["{{BOARD_ROOT}}/server/chat-flow/instructions", "{{BOARD_ROOT}}/boards/{{boardId}}/copilot/worker-default/instructions"],
          "agentsDirs": ["{{BOARD_ROOT}}/server/chat-flow/copilot-chat/agents", "{{BOARD_ROOT}}/boards/{{boardId}}/copilot/worker-default/agents"],
          "agentsSkills": ["{{BOARD_ROOT}}/server/chat-flow/skills", "{{BOARD_ROOT}}/boards/{{boardId}}/copilot/worker-default/skills"],
          "agentsHooks": ["{{BOARD_ROOT}}/server/chat-flow/copilot-chat/hooks", "{{BOARD_ROOT}}/boards/{{boardId}}/copilot/worker-default/hooks"],
          "copyScripts": []
        },
        {
          "copilot-root": "gandalf",
          "instructionsDirs": ["{{BOARD_ROOT}}/server/chat-flow/instructions", "{{BOARD_ROOT}}/boards/{{boardId}}/copilot/gandalf/instructions"],
          "agentsDirs": ["{{BOARD_ROOT}}/server/chat-flow/copilot-chat/agents", "{{BOARD_ROOT}}/boards/{{boardId}}/copilot/gandalf/agents"],
          "agentsSkills": ["{{BOARD_ROOT}}/server/chat-flow/skills", "{{BOARD_ROOT}}/boards/{{boardId}}/copilot/gandalf/skills"],
          "agentsHooks": ["{{BOARD_ROOT}}/server/chat-flow/copilot-chat/hooks", "{{BOARD_ROOT}}/boards/{{boardId}}/copilot/gandalf/hooks"],
          "copyScripts": []
        },
        {
          "copilot-root": "strategist",
          "instructionsDirs": ["{{BOARD_ROOT}}/server/chat-flow/instructions", "{{BOARD_ROOT}}/server/chat-flow/instructions-strategist", "{{BOARD_ROOT}}/boards/{{boardId}}/copilot/strategist/instructions"],
          "agentsDirs": ["{{BOARD_ROOT}}/server/chat-flow/copilot-chat/agents", "{{BOARD_ROOT}}/boards/{{boardId}}/copilot/strategist/agents"],
          "agentsSkills": ["{{BOARD_ROOT}}/server/chat-flow/skills", "{{BOARD_ROOT}}/boards/{{boardId}}/copilot/strategist/skills"],
          "agentsHooks": ["{{BOARD_ROOT}}/server/chat-flow/copilot-chat/hooks", "{{BOARD_ROOT}}/boards/{{boardId}}/copilot/strategist/hooks"],
          "copyScripts": []
        }
      ],
      "copilotSetupScripts": [
        {
          "script": "{{BOARD_ROOT}}/server/sync-copilot-mcp-config.js",
          "args": ["--refresh", "--agentface-url", "{{AGENT_FACE_MCP_URL}}"]
        }
      ]
    }
  },
  "runtimeBoardsRegistry": {
    "localfs": {
      "boards-index": {
        "kind": "fs-path",
        "value": "{{BOARD_ROOT}}/workspaces/_boards-index"
      },
      "boards-layout": {
        "kind": "fs-path",
        "value": "{{BOARD_ROOT}}/workspaces/_boards-layout"
      },
      "deprecatedContainer": {
        "kind": "fs-path",
        "value": "{{BOARD_ROOT}}/workspaces/_deprecated"
      }
    },
    "firebase": {
      "boards-index": {
        "kind": "firestore",
        "value": "boards-index"
      },
      "boards-layout": {
        "kind": "firestore",
        "value": "boards-layout"
      },
      "deprecatedContainer": null
    }
  },
  "sampleTemplateCatalog": {
    "dir": "{{BOARD_ROOT}}/server/hosted-board-runtime/sample-card-templates",
    "indexFile": "{{BOARD_ROOT}}/server/hosted-board-runtime/sample-card-templates/_index.json"
  },
  "uiTemplates": {
    "default": {
      "paneRules": [
        {
          "pane": "gandalf",
          "when": "meta.gandalf = true"
        },
        {
          "pane": "truthset",
          "when": "meta.truthset = true"
        }
      ],
      "cardRendererRules": [
        {
          "renderer": "strategist",
          "when": "meta.card_renderer = 'strategist'"
        },
        {
          "renderer": "ingest",
          "when": "meta.card_renderer = 'ingest'"
        },
        {
          "renderer": "postbox",
          "when": "meta.card_renderer = 'postbox'"
        }
      ],
      "admin-cards": [
        {
          "id": "gandalf-intake",
          "meta": {
            "title": "Board Instructions and Intake",
            "gandalf": true,
            "card_renderer": "ingest",
            "desc": "Board intake card for reviewing and managing incoming evidence."
          },
          "__private": {
            "chat": {"copilot": {"ws": "gandalf"} }
          },
          "view": {
            "elements": [
              {
                "kind": "markdown",
                "data": {
                  "value": "Review and manage incoming evidence for this board."
                }
              }
            ]
          },
          "card_data": {}
        },
                {
          "id": "gandalf-postbox",
          "meta": {
            "title": "Postbox",
            "desc": "Postbox card for ingesting documents into the board via Gandalf. Visible only in Control Plane.",
            "card_renderer": "postbox",
            "gandalf": true
          },
          "view": {
            "elements": [
                            {
                "kind": "markdown",
                "data": {
                  "value": "Review and manage incoming evidence for this board."
                }
              }
            ]
          },
          "card_data": {},
          "__private": {
            "visible_controlplane_only": true
          }
        }
      ]
    },
    "journeys": {
      "paneRules": [
        {
          "pane": "gandalf",
          "when": "meta.gandalf = true"
        },
        {
          "pane": "truthset",
          "when": "meta.truthset = true"
        }
      ],
      "cardRendererRules": [
        {
          "renderer": "strategist",
          "when": "meta.card_renderer = 'strategist'"
        },
        {
          "renderer": "ingest",
          "when": "meta.card_renderer = 'ingest'"
        },
        {
          "renderer": "postbox",
          "when": "meta.card_renderer = 'postbox'"
        }
      ],
      "admin-cards": [
        {
          "id": "gandalf-intake",
          "meta": {
            "title": "Board Instructions and Intake",
            "gandalf": true,
            "card_renderer": "ingest"
          },
          "__private": {
            "chat": {"copilot": {"ws": "gandalf"}, "visible_controlplane_only": true }
          },
          "view": {
            "elements": [
              {
                "kind": "markdown",
                "data": {
                  "value": "Review and manage incoming evidence for this board."
                }
              }
            ]
          },
          "card_data": {}
        },

        {
          "id": "journey-strategist",
          "meta": {
            "title": "Journey Strategist",
            "gandalf": true,
            "card_renderer": "strategist",
            "tags": ["strategist", "journey", "exploration"],
            "desc": "Board-level journey strategist. Wakes on board topology change (sys_keys_board_state) or an edit to its steering, reads the current journey via board-inspection tools, and authors the next move — new or updated cards — to keep the journey advancing toward the seed intent.",
            "presentation": {
              "footprint": "wide"
            }
          },
          "__private": {
            "chat": {"copilot": {"ws": "gandalf"}, "visible_controlplane_only": true }
          },
          "requires": [
            "sys_keys_board_state",
            "nl_intent"
          ],
          "source_defs": [
            {
              "bindTo": "journey_move",
              "outputFile": "journey-strategist-move.json",
              "projections": {
                "question": "requires.nl_intent",
                "steering": "card_data.steering",
                "scope": "card_data.scope",
                "interaction_policy": "card_data.interaction_policy",
                "board_card_ids": "requires.sys_keys_board_state.card_ids",
                "board_token_keys": "requires.sys_keys_board_state.data_object_keys",
                "max_new_cards_per_cycle": "card_data.max_new_cards_per_cycle",
                "max_depth": "card_data.max_depth",
                "max_breadth": "card_data.max_breadth"
              },
              "copilot": {
                "ws": "strategist",
                "result_shape": {
                  "status": null,
                  "move": null,
                  "rationale": null,
                  "created_cards": null,
                  "updated_cards": null,
                  "next_candidates": null
                },
                "prompt_template": "You are the Journey Strategist on the \"{{boardId}}\" journey board. Your workspace instructions (copilot-instructions.md) and skills define the board substrate, the card-authoring contract, the Journey Strategist engine, and this board's journey domain — follow them. This is only your task brief for this cycle.\n\nRUNTIME HANDLES (use exactly): board_id is \"{{boardId}}\". On every liveboards.* tool call that takes a board_id (or board) argument, pass this exact board_id, and pass the provided log_id unchanged.\n\nTHE INTENT (what this journey is pursuing — the single source of truth, editable on the Journey Seed card):\n{{question}}\n\nSTEERING (optional analyst guardrails or priorities; may be empty):\n{{steering}}\n\nSCOPE (optional in-scope data domains, time window, sensitivity; may be empty):\n{{scope}}\n\nINTERACTION POLICY (how autonomous to be; when to surface a decision):\n{{interaction_policy}}\n\nYou were woken because the board or the question changed. Current board shape (your own card and tokens already excluded):\n- card ids: {{board_card_ids}}\n- published token keys: {{board_token_keys}}\n\nThis cycle: sense the board first, then make the single move that most advances the journey and its alignment — deepen, broaden, clarify, offer a decision, reconcile, or hold steady, per your Journey Strategist engine doctrine. Pace: about {{max_new_cards_per_cycle}} authoring move(s), within ~{{max_depth}} steps of the seed and ~{{max_breadth}} parallel threads. Build on existing tokens; never re-query what a token already holds.\n\nRespond with a single JSON object and nothing else, beginning with { and ending with }:\n\n{\n  \"status\": \"advancing | waiting | aligned\",\n  \"move\": \"deepen | broaden | clarify | decide | reconcile | hold\",\n  \"rationale\": \"<a sentence or two grounded in what you actually read>\",\n  \"created_cards\": [ { \"card_id\": \"<id>\", \"purpose\": \"<short>\", \"parent\": \"<parent card id or null>\", \"shape\": \"kusto | copilot | interactive | compute\" } ],\n  \"updated_cards\": [ { \"card_id\": \"<id>\", \"change\": \"<short, e.g. path_state=dead_ended>\" } ],\n  \"next_candidates\": [ \"<a branch you noticed but chose to defer>\" ]\n}"
              }
            }
          ],
          "compute": [
            {
              "bindTo": "status_value",
              "expr": "fetched_sources.journey_move.status ? fetched_sources.journey_move.status : 'idle'"
            },
            {
              "bindTo": "cards_created_count",
              "expr": "fetched_sources.journey_move.created_cards ? $count(fetched_sources.journey_move.created_cards) : 0"
            },
            {
              "bindTo": "journey_size",
              "expr": "requires.sys_keys_board_state.card_ids ? $count(requires.sys_keys_board_state.card_ids) : 0"
            },
            {
              "bindTo": "rationale",
              "expr": "fetched_sources.journey_move.rationale"
            },
            {
              "bindTo": "created_table",
              "expr": "fetched_sources.journey_move.created_cards"
            },
            {
              "bindTo": "next_candidates_list",
              "expr": "fetched_sources.journey_move.next_candidates"
            },
            {
              "bindTo": "move",
              "expr": "fetched_sources.journey_move"
            }
          ],
          "provides": [
            {
              "bindTo": "journey_move",
              "ref": "computed_values.move"
            }
          ],
          "view": {
            "elements": [
              {
                "kind": "notes",
                "label": "Steering / Guardrails (optional)",
                "data": {
                  "bind": "card_data.steering",
                  "writeTo": "card_data.steering"
                }
              },
              {
                "kind": "notes",
                "label": "Scope — data domains, time window (optional)",
                "data": {
                  "bind": "card_data.scope",
                  "writeTo": "card_data.scope"
                }
              },
              {
                "kind": "badge",
                "label": "Strategist Status",
                "data": {
                  "bind": "computed_values.status_value",
                  "colorMap": {
                    "advancing": "success",
                    "waiting": "warning",
                    "aligned": "blue",
                    "idle": "secondary"
                  }
                }
              },
              {
                "kind": "metric",
                "label": "Cards Added This Cycle",
                "data": {
                  "bind": "computed_values.cards_created_count"
                }
              },
              {
                "kind": "metric",
                "label": "Journey Size (cards)",
                "data": {
                  "bind": "computed_values.journey_size"
                }
              },
              {
                "kind": "markdown",
                "label": "Rationale",
                "data": {
                  "bind": "computed_values.rationale"
                }
              },
              {
                "kind": "table",
                "label": "Cards Created This Cycle",
                "data": {
                  "bind": "computed_values.created_table",
                  "columns": [
                    "card_id",
                    "purpose",
                    "parent"
                  ],
                  "maxRows": 12
                }
              },
              {
                "kind": "list",
                "label": "Deferred Branches",
                "data": {
                  "bind": "computed_values.next_candidates_list",
                  "placeholder": "No deferred branches"
                }
              }
            ]
          },
          "card_data": {
            "steering": "",
            "scope": "",
            "interaction_policy": "Follow this board's journey domain for how autonomous to be. Where the domain says the brief is sufficient and to proceed, proceed and keep the journey advancing; surface a decision or clarification card only when the domain calls for the user's judgement or for an input it cannot supply itself.",
            "max_new_cards_per_cycle": 2,
            "max_depth": 6,
            "max_breadth": 4
          }
        }
      ]
    }
  }
}