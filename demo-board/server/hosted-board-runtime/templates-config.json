{
  "refsTemplates": {
    "localfs-default": {
      "baseRef": {
        "kind": "fs-path",
        "value": "{{BOARD_ROOT}}/workspaces/{{boardId}}"
      },
      "boardRuntimeStoreRef": {
        "kind": "fs-path",
        "value": "{{BOARD_ROOT}}/workspaces/{{boardId}}/runtime-board"
      },
      "cardStoreRef": {
        "kind": "fs-path",
        "value": "{{BOARD_ROOT}}/workspaces/{{boardId}}/cards-store"
      },
      "outputsStoreRef": {
        "kind": "fs-path",
        "value": "{{BOARD_ROOT}}/workspaces/{{boardId}}/runtime-outputs"
      },
      "queueStoreRef": {
        "kind": "fs-path",
        "value": "{{BOARD_ROOT}}/workspaces/{{boardId}}/queue-store"
      },
      "scratchStoreRef": {
        "kind": "fs-path",
        "value": "{{BOARD_ROOT}}/workspaces/{{boardId}}/scratch"
      },
      "archiveStoreRef": {
        "kind": "fs-path",
        "value": "{{BOARD_ROOT}}/workspaces/{{boardId}}/archive"
      },
      "chatStoreRef": {
        "kind": "fs-path",
        "value": "{{BOARD_ROOT}}/workspaces/{{boardId}}/cards-chat"
      },
      "artifactsStoreRef": {
        "kind": "fs-path",
        "value": "{{BOARD_ROOT}}/workspaces/{{boardId}}/cards-files"
      },
      "fetchedSourcesStoreRef": {
        "kind": "fs-path",
        "value": "{{BOARD_ROOT}}/workspaces/{{boardId}}/fetched-sources"
      }
    },
    "firestore-default": {
      "baseRef": {
        "kind": "firestore-board",
        "value": "boards/{{boardId}}"
      },
      "boardRuntimeStoreRef": {
        "kind": "firestore",
        "value": "boards/{{boardId}}/runtime-board"
      },
      "cardStoreRef": {
        "kind": "firestore",
        "value": "boards/{{boardId}}/cards"
      },
      "outputsStoreRef": {
        "kind": "firestore",
        "value": "boards/{{boardId}}/runtime-out"
      },
      "queueStoreRef": {
        "kind": "firestore",
        "value": "boards/{{boardId}}/runtime"
      },
      "scratchStoreRef": {
        "kind": "firestore",
        "value": "boards/{{boardId}}/scratch"
      },
      "archiveStoreRef": {
        "kind": "firestore-board",
        "value": "archive-{{boardId}}"
      },
      "chatStoreRef": {
        "kind": "firestore",
        "value": "boards/{{boardId}}/cards-chats"
      },
      "artifactsStoreRef": {
        "kind": "firestore",
        "value": "boards/{{boardId}}/files"
      },
      "fetchedSourcesStoreRef": {
        "kind": "firestore",
        "value": "boards/{{boardId}}/sources"
      }
    }
  },
  "aiWorkspaceTemplates": {
    "default": {
      "paths": {
        "aiWorkspaceRoot": "{{BOARD_ROOT}}/workspaces/{{boardId}}/chat-workspaces",
        "scratchStore": "{{BOARD_ROOT}}/workspaces/{{boardId}}/tmp"
      },
      "ai-workdirs-setup": [
        {
          "copilot-root": "default",
          "instructionsDirs": ["{{BOARD_ROOT}}/server/chat-flow/instructions", "{{BOARD_ROOT}}/boards/{{boardId}}/copilot/default/instructions"],
          "agentsDirs": ["{{BOARD_ROOT}}/server/chat-flow/copilot-chat/agents", "{{BOARD_ROOT}}/boards/{{boardId}}/copilot/default/agents"],
          "agentsSkills": ["{{BOARD_ROOT}}/server/chat-flow/skills", "{{BOARD_ROOT}}/boards/{{boardId}}/copilot/default/skills"],
          "agentsHooks": ["{{BOARD_ROOT}}/server/chat-flow/copilot-chat/hooks", "{{BOARD_ROOT}}/boards/{{boardId}}/copilot/default/hooks"],
          "copyScripts": ["{{BOARD_ROOT}}/scripts/cli"]
        },
        {
          "copilot-root": "gandalf",
          "instructionsDirs": ["{{BOARD_ROOT}}/server/chat-flow/instructions", "{{BOARD_ROOT}}/boards/{{boardId}}/copilot/gandalf/instructions"],
          "agentsDirs": ["{{BOARD_ROOT}}/server/chat-flow/copilot-chat/agents", "{{BOARD_ROOT}}/boards/{{boardId}}/copilot/gandalf/agents"],
          "agentsSkills": ["{{BOARD_ROOT}}/server/chat-flow/skills", "{{BOARD_ROOT}}/boards/{{boardId}}/copilot/gandalf/skills"],
          "agentsHooks": ["{{BOARD_ROOT}}/server/chat-flow/copilot-chat/hooks", "{{BOARD_ROOT}}/boards/{{boardId}}/copilot/gandalf/hooks"],
          "copyScripts": ["{{BOARD_ROOT}}/scripts/cli"]
        }
      ]
    }
  },
  "runtimeBoardsRegistry": {
    "localfs": {
      "boards-index": {
        "kind": "fs-path",
        "value": "{{BOARD_ROOT}}/workspaces/_boards-index"
      },
      "deprecatedContainer": {
        "kind": "fs-path",
        "value": "{{BOARD_ROOT}}/workspaces/_deprecated"
      }
    },
    "firebase": {
      "boards-index": {
        "kind": "firestore",
        "value": "boards-index"
      },
      "deprecatedContainer": null
    }
  },
  "sampleTemplateCatalog": {
    "dir": "{{BOARD_ROOT}}/server/hosted-board-runtime/sample-card-templates",
    "indexFile": "{{BOARD_ROOT}}/server/hosted-board-runtime/sample-card-templates/_index.json"
  },
  "uiTemplates": {
    "default": {
      "filters": {
        "gandalf": "meta.gandalf = true",
        "truthset": "meta.truthset = true"
      },
      "admin-cards": [
        {
          "id": "gandalf-intake",
          "meta": {
            "title": "Evidence Intake",
            "gandalf": true,
            "desc": "Board intake card for reviewing and managing incoming evidence."
          },
          "view": {
            "elements": [
              {
                "kind": "markdown",
                "data": {
                  "value": "Review and manage incoming evidence for this board."
                }
              }
            ]
          },
          "card_data": {}
        }
      ]
    }
  }
}