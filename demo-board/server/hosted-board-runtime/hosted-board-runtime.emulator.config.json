{
  "storageAdapter": "firebase",
  "apiBasePrefix": "/api/boards",
  "firebase": {
    "firebaseConfig": {
      "apiKey": "demo-board-local",
      "authDomain": "demo-board-local.firebaseapp.com",
      "projectId": "demo-board-local",
      "storageBucket": "demo-board-local.appspot.com",
      "messagingSenderId": "000000000000",
      "appId": "1:000000000000:web:demo-board-local"
    },
    "emulators": {
      "firestore": {
        "host": "127.0.0.1",
        "port": 8080
      },
      "storage": {
        "host": "127.0.0.1",
        "port": 9199
      }
    }
  },
  "mcpServerUrl": "http://127.0.0.1:7801/mcp",
  "enableAssistantDebug": false,
  "debugAssistantFile": "",
  "controlface": {
    "host": "127.0.0.1",
    "port": 7799,
    "firebase": {
      "appName": "demo-board-local-controlface"
    }
  },
  "queueRunner": {
    "serverOrigin": "http://127.0.0.1:7799",
    "firebase": {
      "appName": "demo-board-local-queue-runner"
    }
  },
  "sample-boards": {
    "live": {
      "label": "Live",
      "refsTemplate": "firestore-default",
      "uiTemplate": "default"
    }
  }
}
