{
  "storageAdapter": "firebase",
  "apiBasePrefix": "/api/boards",
  "firebase": {
    "firebaseConfig": {
      "apiKey": "demo-board-local",
      "authDomain": "demo-board-local.firebaseapp.com",
      "projectId": "demo-board-local",
      "storageBucket": "demo-board-local.appspot.com",
      "messagingSenderId": "000000000000",
      "appId": "1:000000000000:web:demo-board-local"
    },
    "emulators": {
      "firestore": {
        "host": "127.0.0.1",
        "port": 8080
      },
      "storage": {
        "host": "127.0.0.1",
        "port": 9199
      }
    }
  },
  "mcpServerUrl": "http://127.0.0.1:7801/mcp",
  "enableAssistantDebug": false,
  "debugAssistantFile": "",
  "refsTemplates": {
    "firestore-default": {
      "baseRef": {
        "kind": "firestore-board",
        "value": "boards/{{boardId}}"
      },
      "boardRuntimeStoreRef": {
        "kind": "firestore",
        "value": "boards/{{boardId}}/runtime-board"
      },
      "cardStoreRef": {
        "kind": "firestore",
        "value": "boards/{{boardId}}/cards"
      },
      "outputsStoreRef": {
        "kind": "firestore",
        "value": "boards/{{boardId}}/runtime-out"
      },
      "queueStoreRef": {
        "kind": "firestore",
        "value": "boards/{{boardId}}/runtime"
      },
      "scratchStoreRef": {
        "kind": "firestore",
        "value": "boards/{{boardId}}/scratch"
      },
      "archiveStoreRef": {
        "kind": "firestore-board",
        "value": "archive-{{boardId}}"
      },
      "chatStoreRef": {
        "kind": "firestore",
        "value": "boards/{{boardId}}/cards-chats"
      },
      "artifactsStoreRef": {
        "kind": "firestore",
        "value": "boards/{{boardId}}/files"
      },
      "fetchedSourcesStoreRef": {
        "kind": "firestore",
        "value": "boards/{{boardId}}/sources"
      }
    }
  },
  "controlface": {
    "host": "127.0.0.1",
    "port": 7799,
    "firebase": {
      "appName": "demo-board-local-controlface"
    }
  },
  "queueRunner": {
    "serverOrigin": "http://127.0.0.1:7799",
    "firebase": {
      "appName": "demo-board-local-queue-runner"
    }
  },
  "boards-index": {
    "kind": "firestore",
    "value": "boards-index"
  },
  "uiTemplates": {
    "default": {
      "filters": {
        "gandalf": "meta.gandalf = true",
        "truthset": "meta.truthset = true"
      },
      "admin-cards": [
        {
          "id": "gandalf-intake",
          "meta": {
            "title": "Evidence Intake",
            "gandalf": true,
            "desc": "Board intake card for reviewing and managing incoming evidence."
          },
          "view": {
            "elements": [
              {
                "kind": "markdown",
                "data": {
                  "value": "Review and manage incoming evidence for this board."
                }
              }
            ]
          },
          "card_data": {}
        }
      ]
    }
  },
  "sample-boards": {
    "live": {
      "label": "Live",
      "refsTemplate": "firestore-default",
      "uiTemplate": "default"
    }
  }
}