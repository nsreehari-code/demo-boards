{
  "storageAdapter": "localfs",
  "mcpServerUrl": "http://127.0.0.1:7801/mcp",
  "apiBasePrefix": "/api/boards",
  "enableAssistantDebug": false,
  "debugAssistantFile": "",
  "controlface": {
    "host": "127.0.0.1",
    "port": 7799
  },
  "queueRunner": {
    "serverOrigin": "http://127.0.0.1:7799"
  },
  "foundryAgents": {
    "endpoint": "https://sz-foundry.services.ai.azure.com/api/projects/sz-project",
    "chatAgentId": "asst_IMDJiVnL9fS0QbttDXKxN5lF",
    "taskExecutorAgentId": "asst_IMDJiVnL9fS0QbttDXKxN5lF",
    "chatExposedMcpToolPrefixes": ["liveboards.", "lore."]
  },
  "refsTemplates": {
    "localfs-default": {
      "baseRef": {
        "kind": "fs-path",
        "value": "{{BOARD_ROOT}}/workspaces/{{boardId}}"
      },
      "boardRuntimeStoreRef": {
        "kind": "fs-path",
        "value": "{{BOARD_ROOT}}/workspaces/{{boardId}}/runtime-board"
      },
      "cardStoreRef": {
        "kind": "fs-path",
        "value": "{{BOARD_ROOT}}/workspaces/{{boardId}}/cards-store"
      },
      "outputsStoreRef": {
        "kind": "fs-path",
        "value": "{{BOARD_ROOT}}/workspaces/{{boardId}}/runtime-outputs"
      },
      "queueStoreRef": {
        "kind": "fs-path",
        "value": "{{BOARD_ROOT}}/workspaces/{{boardId}}/queue-store"
      },
      "scratchStoreRef": {
        "kind": "fs-path",
        "value": "{{BOARD_ROOT}}/workspaces/{{boardId}}/scratch"
      },
      "archiveStoreRef": {
        "kind": "fs-path",
        "value": "{{BOARD_ROOT}}/workspaces/{{boardId}}/archive"
      },
      "chatStoreRef": {
        "kind": "fs-path",
        "value": "{{BOARD_ROOT}}/workspaces/{{boardId}}/cards-chat"
      },
      "artifactsStoreRef": {
        "kind": "fs-path",
        "value": "{{BOARD_ROOT}}/workspaces/{{boardId}}/cards-files"
      },
      "fetchedSourcesStoreRef": {
        "kind": "fs-path",
        "value": "{{BOARD_ROOT}}/workspaces/{{boardId}}/fetched-sources"
      }
    }
  },
  "aiWorkspaceTemplates": {
    "default": {
      "paths": {
        "aiWorkspaceRoot": "{{BOARD_ROOT}}/workspaces/{{boardId}}/chat-workspaces",
        "scratchStore": "{{BOARD_ROOT}}/workspaces/{{boardId}}/tmp"
      },
      "ai-workdirs-setup": [
        {
          "copilot-root": "default",
          "instructionsDirs": ["server/chat-flow/instructions", "boards/{{boardId}}/copilot/default/instructions"],
          "agentsDirs": ["server/chat-flow/copilot-chat/agents", "boards/{{boardId}}/copilot/default/agents"],
          "agentsSkills": ["server/chat-flow/skills", "boards/{{boardId}}/copilot/default/skills"],
          "agentsHooks": ["server/chat-flow/copilot-chat/hooks", "boards/{{boardId}}/copilot/default/hooks"],
          "copyScripts": ["scripts/cli"]
        },
        {
          "copilot-root": "gandalf",
          "instructionsDirs": ["server/chat-flow/instructions", "boards/{{boardId}}/copilot/gandalf/instructions"],
          "agentsDirs": ["server/chat-flow/copilot-chat/agents", "boards/{{boardId}}/copilot/gandalf/agents"],
          "agentsSkills": ["server/chat-flow/skills", "boards/{{boardId}}/copilot/gandalf/skills"],
          "agentsHooks": ["server/chat-flow/copilot-chat/hooks", "boards/{{boardId}}/copilot/gandalf/hooks"],
          "copyScripts": ["scripts/cli"]
        }
      ]
    }
  },
  "boards-index": {
    "kind": "fs-path",
    "value": "{{BOARD_ROOT}}/workspaces/boards-index"
  },
  "uiTemplates": {
    "default": {
      "filters": {
        "gandalf": "meta.gandalf = true",
        "truthset": "meta.truthset = true"
      },
      "admin-cards": [
        {
          "id": "gandalf-intake",
          "meta": {
            "title": "Evidence Intake",
            "gandalf": true,
            "desc": "Board intake card for reviewing and managing incoming evidence."
          },
          "view": {
            "elements": [
              {
                "kind": "markdown",
                "data": {
                  "value": "Review and manage incoming evidence for this board."
                }
              }
            ]
          },
          "card_data": {}
        }
      ]
    }
  },
  "sample-boards": {
    "live": {
      "label": "Live",
      "ai": "copilot",
      "chat": {
        "assistant": "foundry",
        "copilot": {
          "custom-workspace-stems": ["gandalf"]
        }
      },
      "aiWorkspaceTemplate": "default",
      "refsTemplate": "localfs-default",
      "uiTemplate": "default"
    },
    "live-test": {
      "label": "Live Test",
      "ai": "copilot",
      "aiWorkspaceTemplate": "default",
      "refsTemplate": "localfs-default"
    }
  }
}