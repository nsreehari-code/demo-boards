{
  "storageAdapter": "firebase",
  "apiBasePrefix": "/api/boards",
  "firebase": {
    "firebaseConfig": {
      "apiKey": "AIzaSyADBND0SZRr44OYpF1AoSPtGOibzn2SbEY",
      "authDomain": "finbook-492706.firebaseapp.com",
      "projectId": "finbook-492706",
