rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAllowedBoard(boardId) {
      return boardId == 'live' || boardId == 'archive-live';
    }

    match /boards/{boardId} {
      allow read, write: if isAllowedBoard(boardId);

      match /{document=**} {
        allow read, write: if isAllowedBoard(boardId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}