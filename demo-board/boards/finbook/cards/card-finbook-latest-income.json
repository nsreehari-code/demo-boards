{
  "id": "card-finbook-latest-income",
  "meta": {
    "title": "Finbook Latest Income",
    "tags": [
      "finbook",
      "mcp",
      "income"
    ],
    "desc": "Shows the latest fiscal total income for each account from the local Finbook repo through MCP.",
    "presentation": {
      "plane": "workspace",
      "priority": 12,
      "emphasis": "wide",
      "column": 2,
      "width": 620
    }
  },
  "requires": [],
  "source_defs": [
    {
      "bindTo": "sarala_income",
      "outputFile": "card-finbook-income-sarala.json",
      "mcp": {
        "server": "finbook",
        "tool": "finbook.run_report",
        "input": {
          "account": "Sarala",
          "report": "income-summary",
          "fy": "2025-26"
        }
      }
    },
    {
      "bindTo": "hari_income",
      "outputFile": "card-finbook-income-hari.json",
      "mcp": {
        "server": "finbook",
        "tool": "finbook.run_report",
        "input": {
          "account": "Hari",
          "report": "income-summary",
          "fy": "2025-26"
        }
      }
    },
    {
      "bindTo": "z_income",
      "outputFile": "card-finbook-income-z.json",
      "mcp": {
        "server": "finbook",
        "tool": "finbook.run_report",
        "input": {
          "account": "Z",
          "report": "income-summary",
          "fy": "2025-26"
        }
      }
    }
  ],
  "compute": [
    {
      "bindTo": "rows",
      "expr": "[{\"account\": \"Sarala\", \"totalIncome\": $round(fetched_sources.sarala_income.data.totalIncome, 2)}, {\"account\": \"Hari\", \"totalIncome\": $round(fetched_sources.hari_income.data.totalIncome, 2)}, {\"account\": \"Z\", \"totalIncome\": $round(fetched_sources.z_income.data.totalIncome, 2)}]"
    }
  ],
  "view": {
    "elements": [
      {
        "kind": "table",
        "label": "Latest Fiscal Total Income",
        "data": {
          "bind": "computed_values.rows",
          "columns": [
            "account",
            "totalIncome"
          ],
          "maxRows": 8
        }
      }
    ],
    "features": {
      "refresh": true
    }
  },
  "card_data": {}
}
