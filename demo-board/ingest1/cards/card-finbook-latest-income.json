{
  "id": "card-finbook-latest-income",
  "meta": {
    "title": "Finbook Latest Income",
    "tags": [
      "finbook",
      "mcp",
      "income"
    ],
    "desc": "Shows the latest fiscal total income for one Finbook account from the connected repo through MCP."
  },
  "requires": [],
  "source_defs": [
    {
      "bindTo": "income",
      "outputFile": "card-finbook-income.json",
      "mcp": {
        "manifest": "../../fintech/data-repos/finbook-data/managed-truthsets/mcp-executable-manifest.json",
        "tool": "finbook.run_report",
        "input": {
          "account": "Sarala",
          "report": "income-summary",
          "fy": "2025-26"
        }
      }
    }
  ],
  "compute": [
    {
      "bindTo": "rows",
      "expr": "fetched_sources.income and fetched_sources.income.data ? [{\"account\": \"Sarala\", \"totalIncome\": $round(fetched_sources.income.data.totalIncome, 2)}] : []"
    }
  ],
  "view": {
    "elements": [
      {
        "kind": "table",
        "label": "Latest Fiscal Total Income",
        "data": {
          "bind": "computed_values.rows",
          "columns": [
            "account",
            "totalIncome"
          ],
          "maxRows": 20
        }
      }
    ],
    "layout": {
      "board": {
        "col": 4,
        "order": 2
      },
      "canvas": {
        "x": 560,
        "y": 80,
        "w": 520,
        "h": 320
      }
    },
    "features": {
      "refresh": true
    }
  },
  "card_data": {}
}
