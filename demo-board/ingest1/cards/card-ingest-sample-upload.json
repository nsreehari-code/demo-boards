{
  "id": "card-ingest-sample-upload",
  "meta": {
    "title": "Sample Ingest Upload",
    "cardRenderer": "ingest",
    "ingestStateField": "X",
    "chatPlaceholder": "Ask for additional files or continue the ingest flow...",
    "doneLabel": "Attached files",
    "tags": [
      "ingest",
      "sample"
    ],
    "desc": "Sample ingest card used to exercise the custom ingest renderer with a seeded file list."
  },
  "requires": [],
  "view": {
    "elements": [
      {
        "kind": "markdown",
        "data": {
          "value": "This card is rendered by the custom ingest renderer."
        }
      }
    ],
    "layout": {
      "board": {
        "col": 4,
        "order": 1
      },
      "canvas": {
        "x": 80,
        "y": 80,
        "w": 420,
        "h": 260
      }
    },
    "features": {
      "refresh": false
    }
  },
  "card_data": {
    "X": "done",
    "files": [
      {
        "name": "income-summary.csv",
        "path": "uploads/income-summary.csv"
      },
      {
        "name": "source-notes.md",
        "path": "uploads/source-notes.md"
      }
    ],
    "messages": [
      {
        "role": "assistant",
        "text": "Upload complete. Review the attached files before continuing."
      }
    ]
  }
}