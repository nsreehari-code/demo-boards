{
  "id": "card-sentinel-demo-triage-plan",
  "meta": {
    "title": "Sentinel Demo Triage Plan",
    "tags": [
      "sentinel",
      "demo",
      "dependencies"
    ],
    "desc": "Builds a downstream response plan from the priority alert token published by the demo chain."
  },
  "requires": [
    "sentinel_demo_alert_feed",
    "sentinel_demo_priority_alerts",
    "sentinel_demo_watchlist_candidates",
    "sentinel_demo_priority_workspace_summary"
  ],
  "compute": [
    {
      "bindTo": "triage_users",
      "expr": "$distinct(requires.sentinel_demo_priority_alerts.user)"
    },
    {
      "bindTo": "triage_rows",
      "expr": "$map(computed_values.triage_users, function($user) {{\"user\": $user, \"priorityAlerts\": $count($filter(requires.sentinel_demo_priority_alerts, function($alert) { $alert.user = $user })), \"recommendedAction\": 'Review sign-in history and revoke active sessions', \"sourceFeedSize\": $count(requires.sentinel_demo_alert_feed), \"watchlistReason\": ($filter(requires.sentinel_demo_watchlist_candidates, function($candidate) { $candidate.user = $user }))[0].reason}})"
    },
    {
      "bindTo": "workspace_actions",
      "expr": "$map(requires.sentinel_demo_priority_workspace_summary, function($workspace) {{\"workspace\": $workspace.workspace, \"highSeverity\": $workspace.highSeverity, \"criticalUsers\": $workspace.criticalUsers, \"recommendedAction\": 'Escalate workspace owner review'}})"
    },
    {
      "bindTo": "brief",
      "expr": "'Consumes four upstream demo tokens to produce a triage queue for **' & $string($count(computed_values.triage_rows)) & '** users and workspace actions for **' & $string($count(computed_values.workspace_actions)) & '** workspaces.'"
    }
  ],
  "provides": [
    {
      "bindTo": "sentinel_demo_triage_plan",
      "ref": "computed_values.triage_rows"
    },
    {
      "bindTo": "sentinel_demo_workspace_actions",
      "ref": "computed_values.workspace_actions"
    }
  ],
  "view": {
    "elements": [
      {
        "kind": "markdown",
        "data": {
          "bind": "computed_values.brief"
        }
      },
      {
        "kind": "table",
        "label": "Recommended Triage Actions",
        "data": {
          "bind": "computed_values.triage_rows",
          "columns": [
            "user",
            "priorityAlerts",
            "recommendedAction",
            "sourceFeedSize"
          ],
          "maxRows": 10
        }
      },
      {
        "kind": "table",
        "label": "Workspace Actions",
        "data": {
          "bind": "computed_values.workspace_actions",
          "columns": [
            "workspace",
            "highSeverity",
            "criticalUsers",
            "recommendedAction"
          ],
          "maxRows": 10
        }
      }
    ],
    "layout": {
      "board": {
        "col": 12,
        "order": 7
      },
      "canvas": {
        "x": 460,
        "y": 930,
        "w": 860,
        "h": 280
      }
    },
    "features": {
      "refresh": false
    }
  },
  "card_data": {}
}