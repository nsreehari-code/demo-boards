{
  "port": 7799,
  "subtitle": "Live operational intelligence for agent workflows",
  "prestart": [
    "node ./server/sync-copilot-mcp-config.js --refresh"
  ],
  "chatFlowTimeoutMs": 1800000,
  "chatInvokeRefTimeoutMs": 1800000,
  "chatCopilotTimeoutMs": 1800000,
  "defaultBoard": "sentinel",
  "boards": {
    "finbook": {
      "label": "Finbook",
      "setup": {
        "setupRoot": "../data-repos-VX/case-workspace",
        "cardStore": "ingest/cards-store",
        "artifactsStore": "ingest/cards-files",
        "boardRuntime": "runtime",
        "boardOutputsStore": "board-outputs",
        "chatStore": "ingest/cards-chats",
        "scratchStore": "scratch",
        "archivalStore": "runtime-archive"
      },
      "regular": {
        "seedCardsDir": "./finbook/cards",
        "taskExecutorPath": "./server/board-worker/task-executor.js",
        "chatHandlerFlowPath": "./server/chat-flow/flow-steps.json"
      }
    },
    "sentinel": {
      "label": "Sentinel Demo",
      "setupDir": "./sentinel/.board-ws",
      "regular": {
        "seedCardsDir": "./sentinel/cards",
        "taskExecutorPath": "./server/board-worker/task-executor.js",
        "chatHandlerFlowPath": "./server/chat-flow/flow-steps.json"
      },
      "copilot-workdirs-setup": [
        { "copilot-root": "default", 
          "instructionsDirs": ["./server/chat-flow/copilot-chat/instructions", "./sentinel/copilot/default/instructions"],
          "agentsDirs": ["./server/chat-flow/copilot-chat/agents", "./sentinel/copilot/default/agents"],
          "agentsSkills": ["./server/chat-flow/copilot-chat/skills", "./sentinel/copilot/default/skills"],
          "agentsHooks": ["./server/chat-flow/copilot-chat/hooks", "./sentinel/copilot/default/hooks"]
        },
        { "copilot-root": "gandalf", 
          "instructionsDirs": ["./server/chat-flow/copilot-chat/instructions", "./sentinel/copilot/gandalf/instructions"],
          "agentsDirs": ["./server/chat-flow/copilot-chat/agents", "./sentinel/copilot/gandalf/agents"],
          "agentsSkills": ["./server/chat-flow/copilot-chat/skills", "./sentinel/copilot/gandalf/skills"],
          "agentsHooks": ["./server/chat-flow/copilot-chat/hooks", "./sentinel/copilot/gandalf/hooks"]
        }
      ]
    }
  }
}
