{
  "port": 7799,
  "subtitle": "Live operational intelligence for agent workflows",
  "prestart": [
    "node ./server/sync-copilot-mcp-config.js --refresh"
  ],
  "chatFlowTimeoutMs": 1800000,
  "chatInvokeRefTimeoutMs": 1800000,
  "chatCopilotTimeoutMs": 1800000,
  "defaultBoard": "sentinel",
  "boards": {
    "finbook": {
      "label": "Finbook",
      "setup": {
        "setupRoot": "../data-repos-VX/case-workspace",
        "cardStore": "ingest/cards-store",
        "artifactsStore": "ingest/cards-files",
        "boardRuntime": "runtime",
        "boardOutputsStore": "board-outputs",
        "chatStore": "ingest/cards-chats",
        "scratchStore": "scratch",
        "archivalStore": "runtime-archive"
      },
      "regular": {
        "seedCardsDir": "./finbook/cards",
        "taskExecutorPath": "./server/board-worker/task-executor.js",
        "chatHandlerFlowPath": "./server/chat-flow/flow-steps.json"
      }
    },
    "sentinel": {
      "label": "Sentinel Demo",
      "setupDir": "./sentinel/.board-ws",
      "regular": {
        "seedCardsDir": "./sentinel/cards",
        "taskExecutorPath": "./server/board-worker/task-executor.js",
        "chatHandlerFlowPath": "./server/chat-flow/flow-steps.json"
      }
    }
  }
}
