    "node ./server/sync-copilot-mcp-config.js --refresh"
  ],
  "mcpServerUrl": "http://127.0.0.1:7801/mcp",
  "chatFlowTimeoutMs": 1800000,
  "chatInvokeRefTimeoutMs": 1800000,
  "chatCopilotTimeoutMs": 1800000,
  "foundryAgents": {
    "endpoint": "https://sz-foundry.services.ai.azure.com/api/projects/sz-project",
    "taskExecutorAgentId": "asst_IMDJiVnL9fS0QbttDXKxN5lF",
    "chatAgentId": "asst_IMDJiVnL9fS0QbttDXKxN5lF",
    "chatExposedMcpToolPrefixes": ["liveboards.", "lore."]
  },
  "watchparty": {
    "outputChannel": "copilot-output",
    "toolsChannel": "copilot-tools",
    "filesForChatDir": "watchparty-files-for-chat"
