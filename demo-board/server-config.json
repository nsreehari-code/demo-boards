{
  "host": "0.0.0.0",
  "port": 7799,
  "ENABLE_LOGGING": true,
  "LOG_FILE": "logs/board-server.log",
  "ENABLE_ASSISTANT_DEBUG": false,
  "DEBUG_ASSISTANT_FILE": "",
