{
  "name": "demo-boards-mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Manifest-driven MCP server scaffold for demo-boards and related data repos.",
  "scripts": {
    "start": "node src/index.js",
    "start:http": "node src/index.js --transport streamable-http",
    "start:stdio": "node src/index.js --transport stdio",
    "dry-run": "node src/index.js --dry-run --transport streamable-http",
    "probe:finbook-workflows": "node scripts/probe-finbook-workflow-tools.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "latest"
  }
}
