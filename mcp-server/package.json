{
  "name": "demo-boards-mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Manifest-driven MCP server scaffold for demo-boards and related data repos.",
  "scripts": {
    "verify:durable-runtime": "node scripts/vendor-gik-durable-runtime.mjs --verify",
    "vendor:durable-runtime": "node scripts/vendor-gik-durable-runtime.mjs",
    "provision:copilot": "node scripts/provision-copilot-agents.mjs",
    "start": "node src/index.js",
    "start:http": "node src/index.js --transport streamable-http",
    "start:stdio": "node src/index.js --transport stdio",
    "dry-run": "node src/index.js --dry-run --transport streamable-http",
    "pretest:smoke": "npm run verify:durable-runtime",
    "test:smoke": "node scripts/smoke-registered-services.js",
    "pretest:filesystem": "npm run verify:durable-runtime",
    "test:filesystem": "node --test test/filesystem-storage.test.js test/filesystem-handler.test.js test/filesystem-mcp.test.js test/filesystem-snapshot-invalidations.test.js",
    "test:proxy": "node --test test/mcp-proxy.test.js",
    "test:copilot": "node --test test/copilot-cli.test.js test/provision-copilot-agents.test.js",
    "test:threat-intel": "node --test test/threat-intel.test.js",
    "smoke:sentinel:tenant": "node scripts/smoke-sentinel-tenant.js",
    "smoke:kusto": "node scripts/smoke-kusto.js",
    "probe:finbook-workflows": "node scripts/probe-finbook-workflow-tools.js"
  },
  "dependencies": {
    "@gik/agent-lifecycle-exp": "file:../../generative-interaction-kernel/packages/agent-lifecycle-exp",
    "@gik/durable-runtime": "file:vendor/gik-durable-runtime-0.7.0.tgz",
    "@modelcontextprotocol/sdk": "latest",
    "chokidar": "^4.0.3"
  }
}
