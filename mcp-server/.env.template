# ---------------------------------------------------------------------------
# mcp-server environment template
# ---------------------------------------------------------------------------
# Copy this file to `.env` (same folder) and fill in real values.
#   cp .env.template .env
# `.env` is gitignored and loaded automatically by src/index.js at startup.
# Every variable is OPTIONAL — manifests fall back to their built-in defaults
# (urlDefault / resource) when a variable is unset. Only set what you need.
# ---------------------------------------------------------------------------

# --- Local board / MCP wiring ----------------------------------------------
# Base URL of this mcp-server's own streamable-http transport. Used by the
# demo-boards.* and lore manifests (urlEnvVar: DEMO_BOARDS_MCP_SERVER_URL).
# Default when unset: http://127.0.0.1:7801/mcp
#DEMO_BOARDS_MCP_SERVER_URL=http://127.0.0.1:7801/mcp

# Base URL of the hosted board controlface server, used by the liveboards
# handler to call board endpoints.
# Default when unset: http://127.0.0.1:7799
#DEMO_BOARD_SERVER_URL=http://127.0.0.1:7799

# --- Optional external MCP data repo ---------------------------------------
# URL for the fintech-data-repo MCP surface (manifests/fintech-data-repo.template.json).
# Default when unset: http://127.0.0.1:7802/mcp
#FINTECH_DATA_REPO_MCP_URL=http://127.0.0.1:7802/mcp

# --- Microsoft Sentinel MCP surfaces ---------------------------------------
# Only needed if you enable the sentinel-* manifests. Auth uses the local
# Azure CLI (az) — no secrets are stored here.
# Azure tenant ID for `az` token acquisition / login.
#SENTINEL_TENANT_ID=00000000-0000-0000-0000-000000000000
# Token audience (resource) for Sentinel. Defaults to the first-party Sentinel
# resource id baked into the manifests; override only for sovereign clouds.
#SENTINEL_RESOURCE=4500ebfb-89b6-4b14-a480-7f749797bfcd

# --- Lore handler ----------------------------------------------------------
# Root directory for the lore store. Defaults to a path derived by the handler
# when unset.
#LORE_ROOT_DIR=

# --- Kusto / Azure Data Explorer (codeboxTesting dataset) ------------------
# Used by the kusto.* tools (manifests/kusto.local.json). Auth uses the local
# Azure CLI (az) to fetch a token for the cluster resource — no secrets stored.
# Cluster query URI. Default points at the codeboxTesting cluster.
#KUSTO_CLUSTER_URI=https://kendradatasets.eastus.kusto.windows.net
# Default database for kusto.* tools when args.database is not supplied.
#KUSTO_DATABASE=codeboxTesting
# Optional Azure tenant ID for `az` token acquisition (sovereign/multi-tenant).
#KUSTO_TENANT_ID=00000000-0000-0000-0000-000000000000

# --- Azure CLI override (advanced) -----------------------------------------
# Explicit path/command for the Azure CLI if `az` is not on PATH.
#AZURE_CLI_COMMAND=az
