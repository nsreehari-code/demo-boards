{
  "server": {
    "name": "demo-boards-filesystem",
    "version": "0.1.0",
    "description": "Root-confined durable filesystem storage tools."
  },
  "tools": [
    {
      "name": "filesystem.create_ref",
      "handler": "filesystem",
      "title": "Create filesystem storage reference",
      "description": "Creates a root-confined fs-path reference for a logical namespace.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "namespace": { "type": "string", "minLength": 1 }
        },
        "required": ["namespace"],
        "additionalProperties": false
      }
    },
    {
      "name": "filesystem.storage_batch",
      "handler": "filesystem",
      "title": "Run filesystem storage operations",
      "description": "Runs an ordered batch against filesystem KV, JSON, Blob, Journal, Queue, Lock, Scratch, or Archive storage.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "operations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "ref": { "type": "string", "minLength": 1 },
                "capability": { "type": "string", "enum": ["kv", "json", "blob", "journal", "queue", "lock", "scratch", "archive"] },
                "operation": { "type": "string", "minLength": 1 },
                "args": { "type": "array" },
                "lane": { "type": "string" },
                "resource": {
                  "type": "object",
                  "properties": {
                    "kind": { "type": "string", "enum": ["stream", "blob"] },
                    "name": { "type": "string", "minLength": 1 }
                  },
                  "required": ["kind", "name"]
                }
              },
              "required": ["ref", "capability", "operation"]
            }
          }
        },
        "required": ["operations"],
        "additionalProperties": false
      }
    },
    {
      "name": "filesystem.runtime_initialize",
      "handler": "filesystem",
      "title": "Initialize filesystem runtime",
      "description": "Creates the initial runtime state when it does not already exist.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "stateRef": { "type": "string", "minLength": 1 },
          "effectsQueueRef": { "type": "string", "minLength": 1 },
          "effectsLane": { "type": "string" },
          "kernelId": { "type": "string", "minLength": 1 },
          "initialState": {}
        },
        "required": ["stateRef", "effectsQueueRef", "kernelId", "initialState"],
        "additionalProperties": false
      }
    },
    {
      "name": "filesystem.transition_acquire",
      "handler": "filesystem",
      "title": "Acquire filesystem transition",
      "description": "Acquires a runtime lock and returns state plus pending journal entries.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "stateRef": { "type": "string", "minLength": 1 },
          "journalRef": { "type": "string", "minLength": 1 },
          "effectsQueueRef": { "type": "string", "minLength": 1 },
          "effectsLane": { "type": "string" },
          "kernelId": { "type": "string", "minLength": 1 },
          "leaseMs": { "type": "integer", "minimum": 1 }
        },
        "required": ["stateRef", "journalRef", "effectsQueueRef", "kernelId"],
        "additionalProperties": false
      }
    },
    {
      "name": "filesystem.transition_commit",
      "handler": "filesystem",
      "title": "Commit filesystem transition",
      "description": "Commits runtime state and effects, then releases the runtime lock.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "stateRef": { "type": "string", "minLength": 1 },
          "journalRef": { "type": "string", "minLength": 1 },
          "effectsQueueRef": { "type": "string", "minLength": 1 },
          "effectsLane": { "type": "string" },
          "kernelId": { "type": "string", "minLength": 1 },
          "leaseToken": { "type": "string", "minLength": 1 },
          "expectedRevision": { "type": ["string", "null"] },
          "previousCursor": { "type": ["string", "null"] },
          "nextCursor": { "type": "string", "minLength": 1 },
          "state": {},
          "effects": { "type": "array" }
        },
        "required": ["stateRef", "journalRef", "effectsQueueRef", "kernelId", "leaseToken", "expectedRevision", "previousCursor", "nextCursor", "state", "effects"],
        "additionalProperties": false
      }
    },
    {
      "name": "filesystem.transition_abort",
      "handler": "filesystem",
      "title": "Abort filesystem transition",
      "description": "Releases a filesystem runtime lock without committing a transition.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "stateRef": { "type": "string", "minLength": 1 },
          "journalRef": { "type": "string", "minLength": 1 },
          "effectsQueueRef": { "type": "string", "minLength": 1 },
          "effectsLane": { "type": "string" },
          "kernelId": { "type": "string", "minLength": 1 },
          "leaseToken": { "type": "string", "minLength": 1 }
        },
        "required": ["stateRef", "journalRef", "effectsQueueRef", "kernelId", "leaseToken"],
        "additionalProperties": false
      }
    }
  ]
}